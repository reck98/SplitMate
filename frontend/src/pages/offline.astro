---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Offline — SplitMate" description="You are currently offline. Please check your internet connection." hideNav noindex={true}>
  <div class="flex flex-1 flex-col items-center justify-center px-6 py-16 text-center">
    <div class="glass mx-auto mb-6 flex h-20 w-20 items-center justify-center rounded-3xl border border-[var(--color-border)] shadow-xl">
      <svg class="h-10 w-10 text-[var(--color-accent)]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
        <path stroke-linecap="round" stroke-linejoin="round" d="M18.364 5.636a9 9 0 010 12.728m-2.829-2.829a5 5 0 000-7.07m-4.243 4.243a1 1 0 010-1.414" />
        <path stroke-linecap="round" stroke-linejoin="round" d="M3.337 6.576a30.429 30.429 0 000 10.848" />
        <path stroke-linecap="round" stroke-linejoin="round" d="M21.422 6.576a30.429 30.429 0 010 10.848" />
        <path stroke-linecap="round" stroke-linejoin="round" d="M1.758 4.242l20.485 20.485" />
      </svg>
    </div>
    <h1 class="mb-2 text-2xl sm:text-3xl font-extrabold text-[var(--color-text-primary)]">You're Offline</h1>
    <p class="mb-8 max-w-sm text-sm text-[var(--color-text-secondary)] leading-relaxed">
      SplitMate needs an active internet connection to sync your expenses. Please check your network connection and try again.
    </p>
    <button
      onclick="location.reload()"
      class="inline-flex items-center gap-2 rounded-2xl bg-[var(--color-accent)] px-6 py-3.5 text-sm font-bold text-white shadow-lg transition-all duration-200 hover:bg-[var(--color-accent-hover)] active:scale-[0.97] cursor-pointer"
    >
      <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M16.023 9.348h4.992v-.001M2.985 19.644v-4.992m0 0h4.992m-4.993 0l3.181 3.183a8.25 8.25 0 0013.803-3.7M4.031 9.865a8.25 8.25 0 0113.803-3.7l3.181 3.182" />
      </svg>
      Retry Connection
    </button>
  </div>
</BaseLayout>
