---
export const prerender = false;

import BaseLayout from "../../../../layouts/BaseLayout.astro";
import GlassButton from "../../../../components/GlassButton.astro";
---

<BaseLayout title="Edit Expense - SplitMate">
  <main class="mx-auto max-w-2xl px-4 py-6">
    <header class="mb-6 animate-fade-in-down">
      <a href="/groups/__ID__" class="inline-flex items-center gap-1.5 text-sm text-[var(--color-text-secondary)] hover:text-[var(--color-accent)] transition-colors mb-4" id="back-link">
        <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 19.5L8.25 12l7.5-7.5" />
        </svg>
        Back to Group
      </a>
      <h1 class="text-3xl font-bold text-[var(--color-text-primary)]">Edit Expense</h1>
      <p class="mt-1 text-sm text-[var(--color-text-secondary)]">Update expense details</p>
    </header>

    <div class="glass-strong rounded-glass-xl p-6 animate-fade-in-up">
      <form id="expense-form" class="space-y-5">
        <div>
          <label for="description" class="block text-sm font-medium text-[var(--color-text-secondary)] mb-1.5">Description</label>
          <input type="text" id="description" required />
        </div>

        <div>
          <label for="amount" class="block text-sm font-medium text-[var(--color-text-secondary)] mb-1.5">Amount (₹)</label>
          <input type="number" id="amount" required min="1" step="0.01" />
        </div>

        <div>
          <label class="block text-sm font-medium text-[var(--color-text-secondary)] mb-1.5">Paid By</label>
          <div class="flex items-center gap-3 glass rounded-[var(--radius-md)] px-4 py-3 opacity-70">
            <div id="payer-avatar" class="flex h-8 w-8 items-center justify-center rounded-full bg-[var(--color-accent)] text-sm font-bold text-white">?</div>
            <div>
              <p id="payer-name" class="text-sm font-medium text-[var(--color-text-primary)]">Loading...</p>
              <p class="text-xs text-[var(--color-text-tertiary)]">Payer cannot be changed</p>
            </div>
          </div>
        </div>

        <div>
          <label class="block text-sm font-medium text-[var(--color-text-secondary)] mb-1.5">Split Type</label>
          <div class="flex gap-2">
            <button type="button" id="equal-split-btn" class="flex-1 inline-flex items-center justify-center gap-2 font-medium rounded-glass-lg px-4 py-2.5 text-sm bg-[var(--color-accent)] text-white transition-all duration-200">Equal</button>
            <button type="button" id="custom-split-btn" class="flex-1 inline-flex items-center justify-center gap-2 font-medium rounded-glass-lg px-4 py-2.5 text-sm glass glass-hover text-[var(--color-text-secondary)] transition-all duration-200">Custom</button>
          </div>
        </div>

        <div>
          <label class="block text-sm font-medium text-[var(--color-text-secondary)] mb-1.5">Participants</label>
          <div id="participants-list" class="space-y-2">
            <p class="text-sm text-[var(--color-text-tertiary)]">Loading members...</p>
          </div>
        </div>

        <div id="custom-split-section" class="hidden space-y-3 glass rounded-glass-lg p-4">
          <label class="block text-sm font-medium text-[var(--color-text-secondary)]">Custom Split Amounts</label>
          <div id="custom-split-inputs" class="space-y-2"></div>
          <p id="split-total" class="text-xs text-[var(--color-text-tertiary)]">Total: ₹0.00</p>
        </div>

        <GlassButton type="submit" variant="primary" size="lg" fullWidth>
          <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M16.862 4.487l1.687-1.688a1.875 1.875 0 112.652 2.652L6.832 19.82a4.5 4.5 0 01-1.897 1.13l-2.685.8.8-2.685a4.5 4.5 0 011.13-1.897L16.863 4.487zm0 0L19.5 7.125" />
          </svg>
          Save Changes
        </GlassButton>
      </form>
    </div>
  </main>

  <script>
    import { api } from "../../../../lib/api";
    import { authInit } from "../../../../lib/firebase";
    import { setUser } from "../../../../stores/auth";

    const pathParts = window.location.pathname.split("/");
    const groupId = pathParts[2];
    const expenseId = pathParts[4];

    let currentSplit = "equal";
    let members: any[] = [];

    document.getElementById("back-link")?.setAttribute("href", `/groups/${groupId}`);

    async function initPage() {
      const fbUser = await authInit;
      if (!fbUser) {
        window.location.href = "/";
        return;
      }

      try {
        const user = await api.auth.me();
        setUser(user);
      } catch {
        window.location.href = "/";
        return;
      }

      await loadExpense();
    }

    async function loadExpense() {
      try {
        const data = await api.groups.get(groupId);
        members = data.members;

        const expense = data.expenses.find((e: any) => e.id === expenseId);
        if (!expense) {
          (window as any).showToast?.({ message: "Expense not found.", type: "error" });
          window.location.href = `/groups/${groupId}`;
          return;
        }

        (document.getElementById("description") as HTMLInputElement).value = expense.description;
        (document.getElementById("amount") as HTMLInputElement).value = expense.amount.toString();

        const payerMember = members.find((m: any) => m.user_id === expense.paid_by);
        const nameEl = document.getElementById("payer-name");
        const avatarEl = document.getElementById("payer-avatar");
        if (nameEl) nameEl.textContent = payerMember?.name || "Unknown";
        if (avatarEl) {
          avatarEl.textContent = (payerMember?.name || "?").charAt(0).toUpperCase();
        }

        const participantIds = expense.participants?.map((p: any) => p.user_id) || [];

        const participantsList = document.getElementById("participants-list")!;
        participantsList.innerHTML = members
          .map(
            (m) => `
            <label class="flex items-center gap-3 glass rounded-glass-lg p-3 cursor-pointer hover:bg-[var(--color-bg-glass-hover)] transition-colors">
              <input type="checkbox" value="${m.user_id}" class="participant-checkbox h-4 w-4 rounded border-[var(--color-border-hover)] text-[var(--color-accent)] focus:ring-[var(--color-accent)]" ${participantIds.includes(m.user_id) ? "checked" : ""} />
              <span class="text-sm text-[var(--color-text-primary)]">${m.name}</span>
            </label>
          `
          )
          .join("");

        const isCustom = expense.split_type === "custom" || (
          expense.participants &&
          expense.participants.length > 0 &&
          expense.participants.some(
            (p: any, _i: number, arr: any[]) => Math.abs(arr[0]?.share_amount - p.share_amount) > 0.05
          )
        );

        const initialValuesMap = new Map<string, string>();
        if (expense.participants) {
          expense.participants.forEach((p: any) => {
            initialValuesMap.set(p.user_id, p.share_amount.toString());
          });
        }

        if (isCustom) {
          currentSplit = "custom";
          document.getElementById("custom-split-btn")!.className = "flex-1 inline-flex items-center justify-center gap-2 font-medium rounded-glass-lg px-4 py-2.5 text-sm bg-[var(--color-accent)] text-white transition-all duration-200";
          document.getElementById("equal-split-btn")!.className = "flex-1 inline-flex items-center justify-center gap-2 font-medium rounded-glass-lg px-4 py-2.5 text-sm glass glass-hover text-[var(--color-text-secondary)] transition-all duration-200";
        }

        participantsList.querySelectorAll(".participant-checkbox").forEach((cb) => {
          cb.addEventListener("change", () => updateCustomSplitInputs());
        });

        if (isCustom) {
          updateCustomSplitInputs(initialValuesMap);
        }
      } catch (error: any) {
        (window as any).showToast?.({ message: error.message, type: "error" });
      }
    }

    function updateCustomSplitInputs(initialMap?: Map<string, string>) {
      const checkboxes = document.querySelectorAll(".participant-checkbox:checked");
      const section = document.getElementById("custom-split-section")!;
      const inputsContainer = document.getElementById("custom-split-inputs")!;

      if (currentSplit === "custom") {
        section.classList.remove("hidden");

        const existingValues = new Map<string, string>();
        document.querySelectorAll(".custom-share").forEach((input) => {
          const uid = (input as HTMLElement).dataset.userId;
          if (uid) {
            existingValues.set(uid, (input as HTMLInputElement).value);
          }
        });

        const totalAmount = parseFloat((document.getElementById("amount") as HTMLInputElement).value) || 0;
        const count = checkboxes.length;
        const defaultShare = count > 0 ? (totalAmount / count).toFixed(2) : "0.00";

        inputsContainer.innerHTML = "";

        checkboxes.forEach((cb) => {
          const userId = (cb as HTMLInputElement).value;
          const member = members.find((m) => m.user_id === userId);
          const existingVal = existingValues.get(userId) ?? initialMap?.get(userId);
          const shareVal = existingVal !== undefined && existingVal !== "" ? existingVal : defaultShare;

          const div = document.createElement("div");
          div.className = "flex items-center gap-2";
          div.innerHTML = `
            <span class="w-24 text-sm text-[var(--color-text-secondary)] truncate">${member?.name || "Unknown"}</span>
            <input type="number" step="0.01" min="0" data-user-id="${userId}" value="${shareVal}" class="custom-share flex-1 rounded-glass-lg border border-[var(--color-border)] bg-[var(--color-bg)] px-3 py-1.5 text-sm text-[var(--color-text-primary)] focus:outline-none focus:ring-2 focus:ring-[var(--color-accent)]" placeholder="0.00" />
          `;
          inputsContainer.appendChild(div);
        });

        inputsContainer.querySelectorAll(".custom-share").forEach((input) => {
          input.addEventListener("input", updateSplitTotal);
        });

        updateSplitTotal();
      } else {
        section.classList.add("hidden");
      }
    }

    function updateSplitTotal() {
      const inputs = document.querySelectorAll(".custom-share");
      let total = 0;
      inputs.forEach((input) => {
        total += parseFloat((input as HTMLInputElement).value) || 0;
      });
      document.getElementById("split-total")!.textContent = `Total: ₹${total.toFixed(2)}`;
    }

    document.getElementById("amount")?.addEventListener("input", () => {
      if (currentSplit === "custom") {
        updateCustomSplitInputs();
      }
    });

    document.getElementById("equal-split-btn")?.addEventListener("click", () => {
      currentSplit = "equal";
      document.getElementById("equal-split-btn")!.className = "flex-1 inline-flex items-center justify-center gap-2 font-medium rounded-glass-lg px-4 py-2.5 text-sm bg-[var(--color-accent)] text-white transition-all duration-200";
      document.getElementById("custom-split-btn")!.className = "flex-1 inline-flex items-center justify-center gap-2 font-medium rounded-glass-lg px-4 py-2.5 text-sm glass glass-hover text-[var(--color-text-secondary)] transition-all duration-200";
      document.getElementById("custom-split-section")!.classList.add("hidden");
    });

    document.getElementById("custom-split-btn")?.addEventListener("click", () => {
      currentSplit = "custom";
      document.getElementById("custom-split-btn")!.className = "flex-1 inline-flex items-center justify-center gap-2 font-medium rounded-glass-lg px-4 py-2.5 text-sm bg-[var(--color-accent)] text-white transition-all duration-200";
      document.getElementById("equal-split-btn")!.className = "flex-1 inline-flex items-center justify-center gap-2 font-medium rounded-glass-lg px-4 py-2.5 text-sm glass glass-hover text-[var(--color-text-secondary)] transition-all duration-200";
      updateCustomSplitInputs();
    });

    document.getElementById("expense-form")?.addEventListener("submit", async (e) => {
      e.preventDefault();

      const target = e.target as HTMLElement;
      const submitBtn = target.querySelector('button[type="submit"]');
      if (submitBtn) {
        (submitBtn as HTMLButtonElement).disabled = true;
        submitBtn.textContent = "Saving...";
      }

      try {
        const description = (document.getElementById("description") as HTMLInputElement).value;
        const amount = parseFloat((document.getElementById("amount") as HTMLInputElement).value);

        const checkedBoxes = document.querySelectorAll(".participant-checkbox:checked");

        if (checkedBoxes.length === 0) {
          (window as any).showToast?.({ message: "Please select at least one participant.", type: "error" });
          if (submitBtn) {
            (submitBtn as HTMLButtonElement).disabled = false;
            submitBtn.textContent = "Save Changes";
          }
          return;
        }

        let participants: any[];

        if (currentSplit === "equal") {
          participants = Array.from(checkedBoxes).map((cb) => (cb as HTMLInputElement).value);
        } else {
          participants = [];
          let totalCustom = 0;
          document.querySelectorAll(".custom-share").forEach((input) => {
            const val = parseFloat((input as HTMLInputElement).value) || 0;
            participants.push({
              user_id: (input as HTMLElement).dataset.userId!,
              share_amount: val,
            });
            totalCustom += val;
          });

          if (Math.abs(totalCustom - amount) > 0.01) {
            (window as any).showToast?.({ message: `Custom split total (₹${totalCustom.toFixed(2)}) must equal expense amount (₹${amount.toFixed(2)}).`, type: "error" });
            if (submitBtn) {
              (submitBtn as HTMLButtonElement).disabled = false;
              submitBtn.textContent = "Save Changes";
            }
            return;
          }
        }

        await api.expenses.update(expenseId, {
          description,
          amount,
          split_type: currentSplit as "equal" | "custom",
          participants,
        });

        (window as any).showToast?.({ message: "Expense updated!", type: "success" });
        setTimeout(() => { window.location.href = `/groups/${groupId}`; }, 300);
      } catch (error: any) {
        (window as any).showToast?.({ message: error.message || "Failed to update expense.", type: "error" });
        if (submitBtn) {
          (submitBtn as HTMLButtonElement).disabled = false;
          submitBtn.textContent = "Save Changes";
        }
      }
    });

    document.addEventListener("DOMContentLoaded", initPage);
  </script>
</BaseLayout>
