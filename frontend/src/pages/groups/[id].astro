---
export const prerender = false;

import BaseLayout from "../../layouts/BaseLayout.astro";
---

<BaseLayout title="Group - SplitMate">
  <main class="mx-auto max-w-2xl px-4 py-6">
    <header class="mb-6 animate-fade-in-down">
      <a href="/dashboard" class="inline-flex items-center gap-1.5 text-sm text-[var(--color-text-secondary)] hover:text-[var(--color-accent)] transition-colors mb-4">
        <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 19.5L8.25 12l7.5-7.5" />
        </svg>
        Back to Dashboard
      </a>
      <div class="flex items-start justify-between gap-4">
        <div>
          <h1 id="group-name" class="text-3xl font-bold text-[var(--color-text-primary)]">Loading...</h1>
          <p id="group-invite" class="mt-1 text-sm text-[var(--color-text-secondary)]"></p>
        </div>
        <div id="owner-actions" class="hidden shrink-0">
          <button id="delete-group-btn" class="inline-flex items-center gap-1.5 rounded-glass-lg px-3 py-1.5 text-xs font-medium bg-[var(--color-danger-soft)] text-[var(--color-danger)] hover:bg-[var(--color-danger)] hover:text-white transition-all duration-200">
            <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M14.74 9l-.346 9m-4.788 0L9.26 9m9.968-3.21c.342.052.682.107 1.022.166m-1.022-.165L18.16 19.673a2.25 2.25 0 01-2.244 2.077H8.084a2.25 2.25 0 01-2.244-2.077L4.772 5.79m14.456 0a48.108 48.108 0 00-3.478-.397m-12 .562c.34-.059.68-.114 1.022-.165m0 0a48.11 48.11 0 013.478-.397m7.5 0v-.916c0-1.18-.91-2.164-2.09-2.201a51.964 51.964 0 00-3.32 0c-1.18.037-2.09 1.022-2.09 2.201v.916m7.5 0a48.667 48.667 0 00-7.5 0" />
            </svg>
            Delete Group
          </button>
        </div>
      </div>
    </header>

    <div class="mb-6 glass rounded-glass-xl p-1 grid grid-cols-4 gap-1 animate-fade-in-up" role="tablist">
      <button data-tab="expenses" class="tab-btn flex items-center justify-center rounded-glass-lg px-2 py-2 sm:px-3 sm:py-2.5 text-xs sm:text-sm font-medium transition-all duration-200" role="tab" aria-selected="true">
        <svg class="h-4 w-4 shrink-0 mr-1 sm:mr-1.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 6v12m-3-2.818l.879.659c1.171.879 3.07.879 4.242 0 1.172-.879 1.172-2.303 0-3.182C13.536 12.219 12.768 12 12 12c-.725 0-1.45-.22-2.003-.659-1.106-.879-1.106-2.303 0-3.182s2.9-.879 4.006 0l.415.33M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
        </svg>
        <span class="truncate">Expenses</span>
      </button>
      <button data-tab="balances" class="tab-btn flex items-center justify-center rounded-glass-lg px-2 py-2 sm:px-3 sm:py-2.5 text-xs sm:text-sm font-medium text-[var(--color-text-secondary)] transition-all duration-200" role="tab" aria-selected="false">
        <svg class="h-4 w-4 shrink-0 mr-1 sm:mr-1.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 3v11.25A2.25 2.25 0 006 16.5h2.25M3.75 3h-1.5m1.5 0h16.5m0 0h1.5m-1.5 0v11.25A2.25 2.25 0 0118 16.5h-2.25m-7.5 0h7.5m-7.5 0l-1 3m8.5-3l1 3m0 0l.5 1.5m-.5-1.5h-9.5m0 0l-.5 1.5m.75-9l3-3 2.148 2.148A12.061 12.061 0 0116.5 7.605" />
        </svg>
        <span class="truncate">Balances</span>
      </button>
      <button data-tab="settlements" class="tab-btn flex items-center justify-center rounded-glass-lg px-2 py-2 sm:px-3 sm:py-2.5 text-xs sm:text-sm font-medium text-[var(--color-text-secondary)] transition-all duration-200" role="tab" aria-selected="false">
        <svg class="h-4 w-4 shrink-0 mr-1 sm:mr-1.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
        </svg>
        <span class="truncate">Settlements</span>
      </button>
      <button data-tab="members" class="tab-btn flex items-center justify-center rounded-glass-lg px-2 py-2 sm:px-3 sm:py-2.5 text-xs sm:text-sm font-medium text-[var(--color-text-secondary)] transition-all duration-200" role="tab" aria-selected="false">
        <svg class="h-4 w-4 shrink-0 mr-1 sm:mr-1.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M15 19.128a9.38 9.38 0 002.625.372 9.337 9.337 0 004.121-.952 4.125 4.125 0 00-7.533-2.493M15 19.128v-.003c0-1.113-.285-2.16-.786-3.07M15 19.128v.106A12.318 12.318 0 018.624 21c-2.331 0-4.512-.645-6.374-1.766l-.001-.109a6.375 6.375 0 0111.964-3.07M12 6.375a3.375 3.375 0 11-6.75 0 3.375 3.375 0 016.75 0zm8.25 2.25a2.625 2.625 0 11-5.25 0 2.625 2.625 0 015.25 0z" />
        </svg>
        <span class="truncate">Members</span>
      </button>
    </div>

    <div id="loading-state" class="space-y-3">
      <div class="glass rounded-glass-xl p-6 text-center">
        <div class="mx-auto mb-4 h-8 w-8 animate-spin rounded-full border-2 border-[var(--color-border)] border-t-[var(--color-accent)]"></div>
        <p class="text-sm text-[var(--color-text-tertiary)]">Loading group details...</p>
      </div>
    </div>

    <div id="expenses-tab" class="tab-content hidden">
      <div class="mb-4 animate-fade-in">
        <a href="/groups/__ID__/add-expense" id="add-expense-link" class="inline-flex w-full items-center justify-center gap-2 font-medium rounded-glass-lg px-4 py-2.5 text-sm bg-[var(--color-accent)] text-white hover:bg-[var(--color-accent-hover)] active:bg-[var(--color-accent-active)] shadow-sm hover:shadow-md transition-all duration-200">
          <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" />
          </svg>
          Add Expense
        </a>
      </div>
      <div id="expenses-list" class="space-y-3"></div>
    </div>

    <div id="balances-tab" class="tab-content hidden">
      <div id="balances-list" class="space-y-3"></div>
    </div>

    <div id="settlements-tab" class="tab-content hidden">
      <div id="settlements-suggestions" class="space-y-2 mb-4"></div>
      <div id="settlements-history" class="space-y-2"></div>
    </div>

    <div id="members-tab" class="tab-content hidden">
      <div class="mb-4">
        <button id="leave-group-btn" class="inline-flex w-full items-center justify-center gap-2 font-medium rounded-glass-lg px-4 py-2.5 text-sm glass glass-hover text-[var(--color-danger)] transition-all duration-200">
          <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 9V5.25A2.25 2.25 0 0013.5 3h-6a2.25 2.25 0 00-2.25 2.25v13.5A2.25 2.25 0 007.5 21h6a2.25 2.25 0 002.25-2.25V15m3 0l3-3m0 0l-3-3m3 3H9" />
          </svg>
          Leave Group
        </button>
      </div>
      <div id="members-list" class="space-y-2"></div>
    </div>
  </main>

  <!-- Debt Settlement Modal -->
  <div id="settlement-modal" class="fixed inset-0 z-50 flex items-center justify-center bg-black/60 backdrop-blur-sm hidden animate-fade-in">
    <div class="w-full max-w-md mx-4 glass-strong rounded-glass-xl p-6 shadow-2xl">
      <div class="flex items-center justify-between mb-4 border-b border-[var(--color-border)] pb-3">
        <h3 class="text-lg font-bold text-[var(--color-text-primary)]" id="settle-modal-title">Settle Payment</h3>
        <button id="close-settle-modal-btn" type="button" class="text-[var(--color-text-tertiary)] hover:text-[var(--color-text-primary)] transition-colors">
          <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>
      <form id="settlement-modal-form" class="space-y-4">
        <input type="hidden" id="settle-payer-id" />
        <input type="hidden" id="settle-receiver-id" />
        <input type="hidden" id="settle-mode" value="cash" />

        <div class="glass rounded-glass-lg p-3 space-y-1.5 text-xs">
          <div class="flex justify-between">
            <span class="text-[var(--color-text-secondary)]">Paid By (Payer):</span>
            <span id="settle-payer-display" class="font-semibold text-[var(--color-text-primary)]"></span>
          </div>
          <div class="flex justify-between">
            <span class="text-[var(--color-text-secondary)]">Paid To (Receiver):</span>
            <span id="settle-receiver-display" class="font-semibold text-[var(--color-text-primary)]"></span>
          </div>
          <div class="flex justify-between pt-1 border-t border-[var(--color-border)]">
            <span class="text-[var(--color-text-secondary)]">Total Owed Debt:</span>
            <span id="settle-max-display" class="font-semibold text-[var(--color-accent)]"></span>
          </div>
        </div>

        <div>
          <label for="settle-amount" class="block text-xs font-medium text-[var(--color-text-secondary)] mb-1">Settlement Amount (₹)</label>
          <input type="number" id="settle-amount" required min="0.01" step="0.01" placeholder="0.00" class="w-full rounded-glass-lg border border-[var(--color-border)] bg-[var(--color-bg)] px-3 py-2 text-sm text-[var(--color-text-primary)] focus:outline-none focus:ring-2 focus:ring-[var(--color-accent)]" />
          <p id="settle-error-msg" class="mt-1 text-xs text-[var(--color-danger)] hidden"></p>
        </div>

        <div class="flex gap-2 pt-2">
          <button type="button" id="cancel-settle-modal-btn" class="flex-1 rounded-glass-lg px-4 py-2 text-sm font-medium glass glass-hover text-[var(--color-text-secondary)]">Cancel</button>
          <button type="submit" id="submit-settle-btn" class="flex-1 rounded-glass-lg px-4 py-2 text-sm font-medium bg-[var(--color-accent)] text-white hover:bg-[var(--color-accent-hover)] transition-all">Confirm Settlement</button>
        </div>
      </form>
    </div>
  </div>

  <script>
    import { authInit } from "../../lib/firebase";
    import { api } from "../../lib/api";
    import { generateUpiLink, openUpiApp } from "../../lib/upi";
    import { setUser } from "../../stores/auth";
    import { saveGroupDetailCache, loadGroupDetailCache } from "../../stores/groups";
    import { connectGroupSSE, disconnectGroupSSE } from "../../lib/sse";
    import { onDOMReady, escapeHtml } from "../../lib/dom";

    const groupId = window.location.pathname.split("/groups/")[1]?.split("/")[0]?.split("?")[0]?.split("#")[0];
    let currentData: any = null;
    let currentUserId: string | null = null;

    function formatCurrency(amount: number): string {
      return `\u20B9${Math.abs(amount).toFixed(2)}`;
    }

    function switchTab(tab: string) {
      document.querySelectorAll(".tab-content").forEach((el) => el.classList.add("hidden"));
      document.querySelectorAll(".tab-btn").forEach((el) => {
        el.classList.remove("bg-[var(--color-accent)]", "text-white");
        el.classList.add("text-[var(--color-text-secondary)]");
        el.setAttribute("aria-selected", "false");
      });
      document.getElementById(`${tab}-tab`)?.classList.remove("hidden");
      const btn = document.querySelector(`[data-tab="${tab}"]`);
      btn?.classList.add("bg-[var(--color-accent)]", "text-white");
      btn?.classList.remove("text-[var(--color-text-secondary)]");
      btn?.setAttribute("aria-selected", "true");
    }

    function renderGroup(data: any) {
      currentData = data;
      saveGroupDetailCache(groupId, data);
      const loading = document.getElementById("loading-state");
      if (loading) loading.classList.add("hidden");

      document.getElementById("group-name")!.textContent = data.group.name;
      document.getElementById("group-invite")!.innerHTML = `
        Invite Code: <span class="font-mono font-medium text-[var(--color-accent)]">${escapeHtml(data.group.invite_code)}</span>
      `;

      const addExpenseLink = document.getElementById("add-expense-link") as HTMLAnchorElement;
      if (addExpenseLink) addExpenseLink.href = `/groups/${groupId}/add-expense`;

      const ownerActions = document.getElementById("owner-actions");
      if (data.group.owner_id === currentUserId) {
        ownerActions?.classList.remove("hidden");
      } else {
        ownerActions?.classList.add("hidden");
      }

      renderExpenses(data);
      renderBalances(data);
      renderMembers(data);
      renderSettlements(data);
    }

    function renderExpenses(data: any) {
      const container = document.getElementById("expenses-list")!;

      if (!data.expenses || data.expenses.length === 0) {
        container.innerHTML = `
          <div class="glass rounded-glass-xl p-8 text-center animate-fade-in">
            <div class="mx-auto mb-4 flex h-12 w-12 items-center justify-center rounded-full bg-[var(--color-bg-glass-hover)]">
              <svg class="h-6 w-6 text-[var(--color-text-tertiary)]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 6v12m-3-2.818l.879.659c1.171.879 3.07.879 4.242 0 1.172-.879 1.172-2.303 0-3.182C13.536 12.219 12.768 12 12 12c-.725 0-1.45-.22-2.003-.659-1.106-.879-1.106-2.303 0-3.182s2.9-.879 4.006 0l.415.33M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
              </svg>
            </div>
            <h3 class="text-lg font-semibold text-[var(--color-text-primary)]">No expenses yet</h3>
            <p class="mt-1 text-sm text-[var(--color-text-tertiary)]">Add your first expense to start tracking</p>
          </div>
        `;
        return;
      }

      container.innerHTML = data.expenses
        .map(
          (exp: any, i: number) => `
          <div class="glass rounded-glass-lg p-4 transition-all duration-200 glass-hover animate-fade-in-up" style="animation-delay: ${i * 40}ms">
            <div class="flex items-start justify-between">
              <div class="flex items-start gap-3">
                <div class="flex h-9 w-9 shrink-0 items-center justify-center rounded-xl bg-[var(--color-accent-soft)]">
                  <svg class="h-4 w-4 text-[var(--color-accent)]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M12 6v12m-3-2.818l.879.659c1.171.879 3.07.879 4.242 0 1.172-.879 1.172-2.303 0-3.182C13.536 12.219 12.768 12 12 12c-.725 0-1.45-.22-2.003-.659-1.106-.879-1.106-2.303 0-3.182s2.9-.879 4.006 0l.415.33" />
                  </svg>
                </div>
                <div>
                  <h4 class="font-medium text-[var(--color-text-primary)]">${escapeHtml(exp.description)}</h4>
                  <p class="text-sm text-[var(--color-text-tertiary)]">Paid by <span class="font-medium text-[var(--color-text-secondary)]">${escapeHtml(exp.paid_by_name)}</span></p>
                </div>
              </div>
              <div class="text-right shrink-0">
                <p class="font-semibold text-[var(--color-text-primary)]">${formatCurrency(exp.amount)}</p>
              </div>
            </div>
            <div class="mt-3 flex flex-wrap gap-1.5">
              ${exp.participants
                .map(
                  (p: any) =>
                    `<span class="inline-flex items-center rounded-full px-2 py-0.5 text-xs font-medium bg-[var(--color-bg-glass-hover)] text-[var(--color-text-secondary)]">${escapeHtml(data.members?.find((m: any) => m.user_id === p.user_id)?.name || "Unknown")}: ${formatCurrency(p.share_amount)}</span>`
                )
                .join("")}
            </div>
            ${
              exp.created_by === currentUserId
                ? `
              <div class="mt-3 flex gap-2 pt-3 border-t border-[var(--color-border)]">
                <a href="/groups/${groupId}/edit-expense/${exp.id}" class="inline-flex items-center gap-1 text-xs font-medium text-[var(--color-text-secondary)] hover:text-[var(--color-accent)] transition-colors">
                  <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M16.862 4.487l1.687-1.688a1.875 1.875 0 112.652 2.652L10.582 16.07a4.5 4.5 0 01-1.897 1.13L6 18l.8-2.685a4.5 4.5 0 011.13-1.897l8.932-8.931zm0 0L19.5 7.125M18 14v4.75A2.25 2.25 0 0115.75 21H5.25A2.25 2.25 0 013 18.75V8.25A2.25 2.25 0 015.25 6H10" />
                  </svg>
                  Edit
                </a>
                <button data-expense-id="${exp.id}" class="delete-expense-btn inline-flex items-center gap-1 text-xs font-medium text-[var(--color-danger)] hover:opacity-80 transition-opacity">
                  <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M14.74 9l-.346 9m-4.788 0L9.26 9m9.968-3.21c.342.052.682.107 1.022.166m-1.022-.165L18.16 19.673a2.25 2.25 0 01-2.244 2.077H8.084a2.25 2.25 0 01-2.244-2.077L4.772 5.79m14.456 0a48.108 48.108 0 00-3.478-.397m-12 .562c.34-.059.68-.114 1.022-.165m0 0a48.11 48.11 0 013.478-.397m7.5 0v-.916c0-1.18-.91-2.164-2.09-2.201a51.964 51.964 0 00-3.32 0c-1.18.037-2.09 1.022-2.09 2.201v.916m7.5 0a48.667 48.667 0 00-7.5 0" />
                  </svg>
                  Delete
                </button>
              </div>
            `
                : ""
            }
          </div>
        `
        )
        .join("");

      container.querySelectorAll(".delete-expense-btn").forEach((btn) => {
        btn.addEventListener("click", async () => {
          (window as any).showToast?.({ message: "Deleting expense...", type: "info" });
          try {
            await api.expenses.delete((btn as HTMLElement).dataset.expenseId!);
            (window as any).showToast?.({ message: "Expense deleted", type: "success" });
          } catch (error: any) {
            (window as any).showToast?.({ message: error.message || "Failed to delete expense", type: "error" });
          }
        });
      });
    }

    function renderBalances(data: any) {
      const container = document.getElementById("balances-list")!;

      if (!data.balances || data.balances.length === 0) {
        container.innerHTML = `
          <div class="glass rounded-glass-xl p-8 text-center animate-fade-in">
            <div class="mx-auto mb-4 flex h-12 w-12 items-center justify-center rounded-full bg-[var(--color-bg-glass-hover)]">
              <svg class="h-6 w-6 text-[var(--color-text-tertiary)]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 3v11.25A2.25 2.25 0 006 16.5h2.25M3.75 3h-1.5m1.5 0h16.5m0 0h1.5m-1.5 0v11.25A2.25 2.25 0 0118 16.5h-2.25m-7.5 0h7.5m-7.5 0l-1 3m8.5-3l1 3m0 0l.5 1.5m-.5-1.5h-9.5m0 0l-.5 1.5" />
              </svg>
            </div>
            <h3 class="text-lg font-semibold text-[var(--color-text-primary)]">No balances</h3>
            <p class="mt-1 text-sm text-[var(--color-text-tertiary)]">Add expenses to see balance breakdown</p>
          </div>
        `;
        return;
      }

      const userBalance = data.balances.find((b: any) => b.user_id === currentUserId);

      let summaryHtml = "";
      if (userBalance) {
        summaryHtml = `
          <div class="glass rounded-glass-lg p-4 mb-4 border-l-4 border-[var(--color-accent)] animate-fade-in space-y-3">
            <p class="text-xs font-semibold uppercase tracking-wider text-[var(--color-text-secondary)]">Your Balance Summary</p>
            <div class="grid grid-cols-2 gap-3">
              <div class="glass rounded-glass p-3 text-center">
                <p class="text-xs text-[var(--color-text-tertiary)] font-medium">You Lent</p>
                <p class="text-base font-bold text-[var(--color-success)]">${formatCurrency(userBalance.lent || 0)}</p>
              </div>
              <div class="glass rounded-glass p-3 text-center">
                <p class="text-xs text-[var(--color-text-tertiary)] font-medium">You Owe</p>
                <p class="text-base font-bold text-[var(--color-danger)]">${formatCurrency(userBalance.owed || 0)}</p>
              </div>
            </div>
            <div class="flex justify-between items-center pt-2 border-t border-[var(--color-border)] text-sm font-semibold">
              <span class="text-[var(--color-text-secondary)]">Overall Net Balance:</span>
              <span class="${userBalance.net_balance > 0.01 ? 'text-[var(--color-success)]' : userBalance.net_balance < -0.01 ? 'text-[var(--color-danger)]' : 'text-[var(--color-text-primary)]'}">
                ${userBalance.net_balance > 0.01 ? '+' : ''}${formatCurrency(userBalance.net_balance || 0)}
              </span>
            </div>
          </div>
        `;
      }

      const balancesListHtml = data.balances
        .map((b: any, i: number) => {
          const isCurrentUser = b.user_id === currentUserId;
          const nameLabel = isCurrentUser ? `${escapeHtml(b.name)} (You)` : escapeHtml(b.name);

          return `
            <div class="glass rounded-glass-lg p-4 flex items-center justify-between animate-fade-in-up" style="animation-delay: ${i * 40}ms">
              <span class="font-medium text-[var(--color-text-primary)]">${nameLabel}</span>
              <div class="text-right text-xs">
                <p>
                  <span class="text-[var(--color-success)] font-semibold">Lent: ${formatCurrency(b.lent || 0)}</span>
                  <span class="text-[var(--color-text-tertiary)] mx-1">|</span>
                  <span class="text-[var(--color-danger)] font-semibold">Owes: ${formatCurrency(b.owed || 0)}</span>
                </p>
              </div>
            </div>
          `;
        })
        .join("");

      container.innerHTML = `
        ${summaryHtml}
        <h4 class="mb-3 text-sm font-medium text-[var(--color-text-secondary)]">Group Member Balances</h4>
        <div class="space-y-2">
          ${balancesListHtml}
        </div>
      `;
    }

    function renderMembers(data: any) {
      const container = document.getElementById("members-list")!;

      container.innerHTML = data.members
        .map(
          (m: any, i: number) => `
          <div class="glass rounded-glass-lg p-4 flex items-center gap-3 animate-fade-in-up" style="animation-delay: ${i * 40}ms">
            ${m.avatar
              ? `<img src="${m.avatar}" alt="${escapeHtml(m.name)}" class="h-10 w-10 rounded-full object-cover" loading="lazy">`
              : `<div class="flex h-10 w-10 items-center justify-center rounded-full bg-[var(--color-accent-soft)] text-sm font-semibold text-[var(--color-accent)]">${escapeHtml(m.name).charAt(0).toUpperCase()}</div>`
            }
            <div class="flex-1 min-w-0">
              <p class="font-medium text-[var(--color-text-primary)] truncate">${escapeHtml(m.name)}</p>
              <p class="text-xs text-[var(--color-text-tertiary)] truncate">${escapeHtml(m.email)}</p>
            </div>
            ${m.user_id === currentUserId ? '<span class="text-xs text-[var(--color-accent)] font-medium">You</span>' : ""}
          </div>
        `
        )
        .join("");
    }

    function renderSettlements(data: any) {
      const suggestionsContainer = document.getElementById("settlements-suggestions")!;
      const historyContainer = document.getElementById("settlements-history")!;

      const userDebts = (data.simplified_debts || []).filter(
        (d: any) => d.from.user_id === currentUserId || d.to.user_id === currentUserId
      );

      if (!userDebts || userDebts.length === 0) {
        suggestionsContainer.innerHTML = `
          <div class="glass rounded-glass-lg p-5 text-center animate-fade-in">
            <div class="mx-auto mb-3 flex h-10 w-10 items-center justify-center rounded-full bg-[var(--color-success-soft)]">
              <svg class="h-5 w-5 text-[var(--color-success)]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
              </svg>
            </div>
            <p class="text-sm font-medium text-[var(--color-text-primary)]">All settled up!</p>
            <p class="text-xs text-[var(--color-text-tertiary)] mt-1">No outstanding payments</p>
          </div>
        `;
      } else {
        suggestionsContainer.innerHTML = `
          <h4 class="mb-3 text-sm font-medium text-[var(--color-text-secondary)]">Suggested Payments</h4>
          ${userDebts
            .map((d: any, i: number) => {
              const isDebtor = d.from.user_id === currentUserId;
              const isCreditor = d.to.user_id === currentUserId;
              const descTag = d.description ? ` for <span class="font-medium italic text-[var(--color-accent)]">"${escapeHtml(d.description)}"</span>` : "";

              let label: string;
              if (isDebtor) {
                label = `You should pay <span class="font-medium text-[var(--color-text-primary)]">${escapeHtml(d.to.name)}</span>${descTag}`;
              } else {
                label = `<span class="font-medium text-[var(--color-text-primary)]">${escapeHtml(d.from.name)}</span> should pay you${descTag}`;
              }

              const showPayBtn = isDebtor;
              const showSettleCashBtn = isDebtor || isCreditor;

              return `
            <div class="glass rounded-glass-lg p-4 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-3 sm:gap-2 animate-fade-in-up" style="animation-delay: ${i * 40}ms">
              <div class="text-sm text-[var(--color-text-secondary)] flex-1 min-w-0">
                ${label}
              </div>
              <div class="flex items-center gap-2 shrink-0 w-full sm:w-auto justify-between sm:justify-end">
                <span class="font-semibold text-[var(--color-text-primary)] mr-1 text-base sm:text-sm">${formatCurrency(d.amount)}</span>
                <div class="flex items-center gap-2">
                  ${showPayBtn
                    ? `<button
                        data-payer="${d.from.user_id}"
                        data-receiver="${d.to.user_id}"
                        data-amount="${d.amount}"
                        class="settle-upi-btn inline-flex items-center gap-1 rounded-glass-lg px-2.5 py-1.5 text-xs font-medium bg-[var(--color-accent)] text-white hover:bg-[var(--color-accent-hover)] transition-all duration-200"
                      >
                        <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                          <path stroke-linecap="round" stroke-linejoin="round" d="M3 7.5L7.5 3m0 0L12 7.5M7.5 3v13.5m13.5 0L16.5 21m0 0L12 16.5m4.5 4.5V7.5" />
                        </svg>
                        Pay via UPI
                      </button>`
                    : ""
                  }
                  ${showSettleCashBtn
                    ? `<button
                        data-payer="${d.from.user_id}"
                        data-receiver="${d.to.user_id}"
                        data-amount="${d.amount}"
                        class="settle-cash-btn inline-flex items-center gap-1 rounded-glass-lg px-2.5 py-1.5 text-xs font-medium glass glass-hover text-[var(--color-text-primary)] hover:bg-[var(--color-success-soft)] hover:text-[var(--color-success)] transition-all duration-200"
                      >
                        <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                          <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                        </svg>
                        Settle Cash
                      </button>`
                    : ""
                  }
                </div>
              </div>
            </div>
          `;
            })
            .join("")}
        `;

        suggestionsContainer.querySelectorAll(".settle-upi-btn").forEach((btn) => {
          btn.addEventListener("click", () => {
            const payerId = (btn as HTMLElement).dataset.payer!;
            const receiverId = (btn as HTMLElement).dataset.receiver!;
            const amount = parseFloat((btn as HTMLElement).dataset.amount!);
            openDebtSettlementModal(payerId, receiverId, amount, "upi");
          });
        });

        suggestionsContainer.querySelectorAll(".settle-cash-btn").forEach((btn) => {
          btn.addEventListener("click", () => {
            const payerId = (btn as HTMLElement).dataset.payer!;
            const receiverId = (btn as HTMLElement).dataset.receiver!;
            const amount = parseFloat((btn as HTMLElement).dataset.amount!);
            openDebtSettlementModal(payerId, receiverId, amount, "cash");
          });
        });
      }

      if (data.settlements && data.settlements.length > 0) {
        historyContainer.innerHTML = `
          <h4 class="mb-3 mt-6 text-sm font-medium text-[var(--color-text-secondary)]">Settlement History</h4>
          ${data.settlements
            .map(
              (s: any, i: number) => `
            <div class="glass rounded-glass-lg p-4 flex items-center justify-between animate-fade-in-up" style="animation-delay: ${i * 40}ms">
              <div class="flex items-center gap-3">
                <div class="flex h-8 w-8 items-center justify-center rounded-lg bg-[var(--color-success-soft)]">
                  <svg class="h-4 w-4 text-[var(--color-success)]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                  </svg>
                </div>
                <span class="text-sm">
                  <span class="font-medium text-[var(--color-text-primary)]">${escapeHtml(s.payer_name)}</span>
                  <span class="text-[var(--color-text-tertiary)]"> paid </span>
                  <span class="font-medium text-[var(--color-text-primary)]">${escapeHtml(s.receiver_name)}</span>
                </span>
              </div>
              <span class="font-semibold text-[var(--color-success)]">${formatCurrency(s.amount)}</span>
            </div>
          `
            )
            .join("")}
        `;
      } else {
        historyContainer.innerHTML = "";
      }
    }

    function openDebtSettlementModal(payerId: string, receiverId: string, maxAmount: number, mode: "cash" | "upi") {
      const modal = document.getElementById("settlement-modal");
      const payerIdInput = document.getElementById("settle-payer-id") as HTMLInputElement;
      const receiverIdInput = document.getElementById("settle-receiver-id") as HTMLInputElement;
      const modeInput = document.getElementById("settle-mode") as HTMLInputElement;
      const payerDisplay = document.getElementById("settle-payer-display")!;
      const receiverDisplay = document.getElementById("settle-receiver-display")!;
      const maxDisplay = document.getElementById("settle-max-display")!;
      const amountInput = document.getElementById("settle-amount") as HTMLInputElement;
      const errorMsg = document.getElementById("settle-error-msg")!;
      const modalTitle = document.getElementById("settle-modal-title")!;
      const submitBtn = document.getElementById("submit-settle-btn") as HTMLButtonElement;

      payerIdInput.value = payerId;
      receiverIdInput.value = receiverId;
      modeInput.value = mode;

      const payer = currentData?.members?.find((m: any) => m.user_id === payerId);
      const receiver = currentData?.members?.find((m: any) => m.user_id === receiverId);

      payerDisplay.textContent = payerId === currentUserId ? "You" : (payer?.name || "Payer");
      receiverDisplay.textContent = receiverId === currentUserId ? "You" : (receiver?.name || "Receiver");
      maxDisplay.textContent = formatCurrency(maxAmount);

      amountInput.value = maxAmount.toFixed(2);
      amountInput.max = maxAmount.toString();
      errorMsg.classList.add("hidden");
      errorMsg.textContent = "";

      if (mode === "upi") {
        modalTitle.textContent = "Settle via UPI";
        submitBtn.textContent = "Pay via UPI & Settle";
      } else {
        modalTitle.textContent = "Settle via Cash";
        submitBtn.textContent = "Confirm Cash Settlement";
      }

      modal?.classList.remove("hidden");
    }

    async function loadGroupData() {
      try {
        const data = await api.groups.get(groupId);
        renderGroup(data);
      } catch (error: any) {
        const loading = document.getElementById("loading-state");
        if (loading) {
          loading.innerHTML = `
            <div class="glass rounded-glass-xl p-8 text-center animate-fade-in">
              <div class="mx-auto mb-4 flex h-12 w-12 items-center justify-center rounded-full bg-[var(--color-danger-soft)]">
                <svg class="h-6 w-6 text-[var(--color-danger)]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m9-.75a9 9 0 11-18 0 9 9 0 0118 0zm-9 3.75h.008v.008H12v-.008z" />
                </svg>
              </div>
              <h3 class="text-lg font-semibold text-[var(--color-text-primary)]">Failed to load</h3>
              <p class="mt-1 text-sm text-[var(--color-text-tertiary)]">${escapeHtml(error.message)}</p>
              <button onclick="location.reload()" class="mt-4 inline-flex items-center justify-center gap-2 font-medium rounded-glass-lg px-4 py-2.5 text-sm bg-[var(--color-accent)] text-white hover:bg-[var(--color-accent-hover)] transition-all duration-200">
                Retry
              </button>
            </div>
          `;
        }
      }
    }

    document.querySelectorAll(".tab-btn").forEach((btn) => {
      btn.addEventListener("click", () => {
        switchTab((btn as HTMLElement).dataset.tab!);
      });
    });

    document.getElementById("delete-group-btn")?.addEventListener("click", async () => {
      if (!confirm("Delete this group permanently? This cannot be undone.")) return;
      try {
        await api.groups.delete(groupId);
        window.location.href = "/dashboard";
      } catch (error: any) {
        (window as any).showToast?.({ message: error.message || "Failed to delete group", type: "error" });
      }
    });

    document.getElementById("leave-group-btn")?.addEventListener("click", async () => {
      if (!confirm("Leave this group? You can only leave if you have no outstanding balance.")) return;
      try {
        await api.groups.leave(groupId);
        window.location.href = "/dashboard";
      } catch (error: any) {
        (window as any).showToast?.({ message: error.message || "Failed to leave group", type: "error" });
      }
    });

    const modal = document.getElementById("settlement-modal");
    const closeModalBtn = document.getElementById("close-settle-modal-btn");
    const cancelModalBtn = document.getElementById("cancel-settle-modal-btn");
    const modalForm = document.getElementById("settlement-modal-form");

    function closeModal() {
      modal?.classList.add("hidden");
    }

    closeModalBtn?.addEventListener("click", closeModal);
    cancelModalBtn?.addEventListener("click", closeModal);

    modalForm?.addEventListener("submit", async (e) => {
      e.preventDefault();

      const payerId = (document.getElementById("settle-payer-id") as HTMLInputElement).value;
      const receiverId = (document.getElementById("settle-receiver-id") as HTMLInputElement).value;
      const mode = (document.getElementById("settle-mode") as HTMLInputElement).value;
      const amountInput = document.getElementById("settle-amount") as HTMLInputElement;
      const errorMsg = document.getElementById("settle-error-msg")!;
      const amount = parseFloat(amountInput.value);
      const maxAmount = parseFloat(amountInput.max);

      if (isNaN(amount) || amount <= 0) {
        errorMsg.textContent = "Please enter a valid amount greater than 0.";
        errorMsg.classList.remove("hidden");
        return;
      }

      if (amount > maxAmount + 0.01) {
        errorMsg.textContent = `Settlement amount cannot exceed the owed debt of ${formatCurrency(maxAmount)}.`;
        errorMsg.classList.remove("hidden");
        return;
      }

      errorMsg.classList.add("hidden");

      const submitBtn = document.getElementById("submit-settle-btn") as HTMLButtonElement;
      if (submitBtn) {
        submitBtn.disabled = true;
        submitBtn.textContent = mode === "upi" ? "Opening UPI..." : "Saving...";
      }

      try {
        if (mode === "upi") {
          const receiver = currentData?.members?.find((m: any) => m.user_id === receiverId);
          if (!receiver?.upi_id) {
            (window as any).showToast?.({ message: `${receiver?.name || "Receiver"} has no UPI ID set. Recording cash settlement instead.`, type: "info" });
          } else {
            const upiLink = generateUpiLink({
              payeeAddress: receiver.upi_id,
              amount,
            });
            openUpiApp(upiLink);
          }
        }

        await api.settlements.create(groupId, {
          payer_id: payerId,
          receiver_id: receiverId,
          amount,
        });

        (window as any).showToast?.({ message: "Settlement recorded successfully", type: "success" });
        closeModal();
      } catch (error: any) {
        errorMsg.textContent = error.message || "Failed to record settlement";
        errorMsg.classList.remove("hidden");
      } finally {
        if (submitBtn) {
          submitBtn.disabled = false;
          submitBtn.textContent = mode === "upi" ? "Pay via UPI & Settle" : "Confirm Settlement";
        }
      }
    });

    onDOMReady(async () => {
      // SWR: Render cached group data immediately if available
      const cachedData = loadGroupDetailCache(groupId);
      if (cachedData) {
        renderGroup(cachedData);
        switchTab("expenses");
      }

      const fbUser = await authInit;
      if (!fbUser) {
        window.location.href = "/";
        return;
      }

      const userPromise = api.auth.me();
      const dataPromise = api.groups.get(groupId).catch(() => null);

      try {
        const user = await userPromise;
        currentUserId = user.id;
        setUser(user);
      } catch {
        window.location.href = "/";
        return;
      }

      const data = await dataPromise;
      if (data) {
        renderGroup(data);
      } else {
        await loadGroupData();
      }
      switchTab("expenses");

      connectGroupSSE(groupId, {
        onUpdate: () => {
          loadGroupData().catch(() => {});
        },
      });
    });

    document.addEventListener("visibilitychange", () => {
      if (document.visibilityState === "visible") {
        loadGroupData().catch(() => {});
      }
    });

    window.addEventListener("online", () => {
      loadGroupData().catch(() => {});
    });

    window.addEventListener("beforeunload", () => {
      disconnectGroupSSE();
    });
  </script>
</BaseLayout>
