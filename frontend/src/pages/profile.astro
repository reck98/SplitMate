---
import BaseLayout from "../layouts/BaseLayout.astro";
import GlassCard from "../components/GlassCard.astro";
import Skeleton from "../components/Skeleton.astro";
---

<BaseLayout title="Profile - SplitMate">
  <main class="mx-auto max-w-2xl px-4 py-6">
    <header class="mb-6 animate-fade-in-down">
      <a href="/dashboard" class="inline-flex items-center gap-1.5 text-sm text-[var(--color-text-secondary)] hover:text-[var(--color-accent)] transition-colors mb-4">
        <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 19.5L8.25 12l7.5-7.5" />
        </svg>
        Back to Dashboard
      </a>
      <h1 class="text-3xl font-bold text-[var(--color-text-primary)]">Profile</h1>
      <p class="mt-1 text-sm text-[var(--color-text-secondary)]">Manage your account settings</p>
    </header>

    <div id="profile-content" class="space-y-4">
      <GlassCard padding="lg">
        <div class="flex items-center gap-4">
          <Skeleton width="64px" height="64px" variant="circle" />
          <div class="space-y-2 flex-1">
            <Skeleton width="50%" height="24px" />
            <Skeleton width="40%" height="14px" />
          </div>
        </div>
      </GlassCard>
    </div>
  </main>

  <script>
    import { authInit, auth } from "../lib/firebase";
    import { api } from "../lib/api";
    import { setUser, clearAuth } from "../stores/auth";
    import { disconnectGroupSSE } from "../lib/sse";

    document.addEventListener("DOMContentLoaded", async () => {
      const firebaseUser = await authInit;
      if (!firebaseUser) {
        window.location.href = "/";
        return;
      }

      try {
        const user = await api.auth.me();
        setUser(user);

        const container = document.getElementById("profile-content")!;
        container.innerHTML = `
          <div class="glass rounded-glass-xl p-6 animate-fade-in-up">
            <div class="flex items-center gap-4">
              ${user.avatar
                ? `<img id="profile-avatar-img" src="${user.avatar}" alt="${user.name}" class="h-16 w-16 rounded-full object-cover ring-2 ring-[var(--color-accent-soft)]" loading="lazy">`
                : `<div id="profile-avatar-fallback" class="flex h-16 w-16 items-center justify-center rounded-full bg-[var(--color-accent-soft)] text-2xl font-bold text-[var(--color-accent)] ring-2 ring-[var(--color-accent-soft)]">${user.name.charAt(0).toUpperCase()}</div>`
              }
              <div>
                <h2 id="profile-header-name" class="text-xl font-bold text-[var(--color-text-primary)]">${user.name}</h2>
                <p class="text-sm text-[var(--color-text-tertiary)]">${user.email}</p>
                <p class="text-xs text-[var(--color-text-tertiary)] mt-0.5">Avatar managed by Google/Firebase</p>
              </div>
            </div>
          </div>

          <form id="edit-profile-form" class="glass rounded-glass-xl p-6 space-y-4 animate-fade-in-up" style="animation-delay: 40ms">
            <h3 class="text-base font-bold text-[var(--color-text-primary)] border-b border-[var(--color-border)] pb-2">Edit Profile</h3>
            
            <div>
              <label for="display_name" class="block text-xs font-medium text-[var(--color-text-secondary)] mb-1">Display Name</label>
              <input type="text" id="display_name" value="${user.name}" placeholder="Your display name" required class="w-full" />
            </div>

            <div>
              <label for="profile_email" class="block text-xs font-medium text-[var(--color-text-secondary)] mb-1">Email (Read-only)</label>
              <input type="email" id="profile_email" value="${user.email}" readonly disabled class="w-full opacity-70 cursor-not-allowed bg-[var(--color-bg-glass-hover)]" />
            </div>

            <div>
              <label for="upi_id" class="block text-xs font-medium text-[var(--color-text-secondary)] mb-1">UPI ID</label>
              <input type="text" id="upi_id" value="${user.upi_id || ""}" placeholder="Set your UPI ID (e.g., name@upi)" class="w-full" />
            </div>

            <div class="pt-2 flex justify-end">
              <button type="submit" id="save-profile-btn" class="inline-flex items-center justify-center gap-2 font-medium rounded-glass-lg px-5 py-2.5 text-sm bg-[var(--color-accent)] text-white hover:bg-[var(--color-accent-hover)] transition-all duration-200">
                Save Changes
              </button>
            </div>
          </form>

          <div class="glass rounded-glass-xl p-6 animate-fade-in-up" style="animation-delay: 80ms">
            <div class="flex items-center gap-3">
              <div class="flex h-10 w-10 items-center justify-center rounded-lg bg-[var(--color-info-soft)]">
                <svg class="h-5 w-5 text-[var(--color-info)]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 5.25a3 3 0 013 3m3 0a6 6 0 01-7.029 5.912c-.563-.097-1.159.026-1.563.43L10.5 17.25H8.25v2.25H6v2.25H2.25v-2.818c0-.597.237-1.17.659-1.591l6.499-6.499c.404-.404.527-1 .43-1.563A6 6 0 1121.75 8.25z" />
                </svg>
              </div>
              <div>
                <h3 class="font-medium text-[var(--color-text-primary)]">Account</h3>
                <p class="text-sm text-[var(--color-text-tertiary)]">Connected with Google</p>
              </div>
            </div>
          </div>

          <button id="logout-btn" class="inline-flex w-full items-center justify-center gap-2 font-medium rounded-glass-xl px-4 py-3 text-sm glass glass-hover text-[var(--color-danger)] transition-all duration-200 animate-fade-in-up" style="animation-delay: 120ms">
            <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 9V5.25A2.25 2.25 0 0013.5 3h-6a2.25 2.25 0 00-2.25 2.25v13.5A2.25 2.25 0 007.5 21h6a2.25 2.25 0 002.25-2.25V15m3 0l3-3m0 0l-3-3m3 3H9" />
            </svg>
            Sign Out
          </button>
        `;

        const form = document.getElementById("edit-profile-form") as HTMLFormElement;
        form?.addEventListener("submit", async (e) => {
          e.preventDefault();
          const nameInput = document.getElementById("display_name") as HTMLInputElement;
          const upiInput = document.getElementById("upi_id") as HTMLInputElement;
          const saveBtn = document.getElementById("save-profile-btn") as HTMLButtonElement;

          const nameVal = nameInput.value.trim();
          const upiVal = upiInput.value.trim();

          if (!nameVal) {
            (window as any).showToast?.({ message: "Display name cannot be empty.", type: "error" });
            return;
          }

          if (saveBtn) {
            saveBtn.disabled = true;
            saveBtn.textContent = "Saving...";
          }

          try {
            const updatedUser = await api.auth.updateProfile({
              name: nameVal,
              upi_id: upiVal || undefined,
            });
            setUser(updatedUser);

            const headerName = document.getElementById("profile-header-name");
            if (headerName) headerName.textContent = updatedUser.name;

            const fallbackAvatar = document.getElementById("profile-avatar-fallback");
            if (fallbackAvatar) fallbackAvatar.textContent = updatedUser.name.charAt(0).toUpperCase();

            (window as any).showToast?.({ message: "Profile updated successfully", type: "success" });
          } catch (error: any) {
            (window as any).showToast?.({ message: error.message || "Failed to update profile", type: "error" });
          } finally {
            if (saveBtn) {
              saveBtn.disabled = false;
              saveBtn.textContent = "Save Changes";
            }
          }
        });

        document.getElementById("logout-btn")?.addEventListener("click", async () => {
          disconnectGroupSSE();
          clearAuth();
          await auth.signOut();
          window.location.href = "/";
        });
      } catch {
        window.location.href = "/";
      }
    });
  </script>
</BaseLayout>
