---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout>
  <main class="flex min-h-screen flex-col items-center justify-center px-4">
    <div class="w-full max-w-sm text-center">
      <div class="mb-4 text-6xl font-bold text-gray-300">404</div>
      <h1 class="mb-2 text-2xl font-bold text-gray-900">Page Not Found</h1>
      <p class="mb-6 text-gray-600">The page you're looking for doesn't exist.</p>
      <a href="/" class="btn-primary">Go Home</a>
    </div>
  </main>
</BaseLayout>
