---
import BaseLayout from "../layouts/BaseLayout.astro";
import GlassButton from "../components/GlassButton.astro";
---

<BaseLayout title="Create Group - SplitMate">
  <main class="mx-auto max-w-2xl px-4 py-6">
    <header class="mb-6 animate-fade-in-down">
      <a href="/dashboard" class="inline-flex items-center gap-1.5 text-sm text-[var(--color-text-secondary)] hover:text-[var(--color-accent)] transition-colors mb-4">
        <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 19.5L8.25 12l7.5-7.5" />
        </svg>
        Back to Dashboard
      </a>
      <h1 class="text-3xl font-bold text-[var(--color-text-primary)]">Create Group</h1>
      <p class="mt-1 text-sm text-[var(--color-text-secondary)]">
        Create a group to start sharing expenses with friends.
      </p>
    </header>

    <div class="glass-strong rounded-glass-xl p-6 animate-fade-in-up">
      <form id="create-group-form" class="space-y-4">
        <div>
          <label for="name" class="block text-sm font-medium text-[var(--color-text-secondary)] mb-1.5">
            Group Name
          </label>
          <input
            type="text"
            id="name"
            name="name"
            placeholder="e.g., Trip to Goa"
            required
            maxlength="100"
            autocomplete="off"
          />
        </div>

        <GlassButton type="submit" variant="primary" size="lg" fullWidth>
          <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" />
          </svg>
          Create Group
        </GlassButton>
      </form>
    </div>
  </main>

  <script>
    import { api } from "../lib/api";

    document
      .getElementById("create-group-form")
      ?.addEventListener("submit", async (e) => {
        e.preventDefault();

        const input = document.getElementById("name") as HTMLInputElement;
        const target = e.target as HTMLElement;
        const submitBtn = target.querySelector('button[type="submit"]');

        if (submitBtn) {
          (submitBtn as HTMLButtonElement).disabled = true;
          submitBtn.textContent = "Creating...";
        }

        try {
          await api.groups.create(input.value);
          (window as any).showToast?.({ message: "Group created successfully!", type: "success" });
          setTimeout(() => { window.location.href = "/dashboard"; }, 300);
        } catch (error: any) {
          (window as any).showToast?.({ message: error.message || "Failed to create group.", type: "error" });
          if (submitBtn) {
            (submitBtn as HTMLButtonElement).disabled = false;
            submitBtn.textContent = "Create Group";
          }
        }
      });
  </script>
</BaseLayout>
