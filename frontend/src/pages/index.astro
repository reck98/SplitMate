---
import BaseLayout from "../layouts/BaseLayout.astro";
import GlassButton from "../components/GlassButton.astro";
---

<BaseLayout hideNav>
  <!-- Loading splash (visible while auth initializes) -->
  <div id="loading-splash" class="fixed inset-0 z-50 flex items-center justify-center" style="background: var(--color-bg);">
    <div class="flex flex-col items-center gap-3">
      <div class="h-8 w-8 animate-spin rounded-full border-4 border-[var(--color-accent)] border-t-transparent"></div>
      <p class="text-sm text-[var(--color-text-secondary)]">Loading...</p>
    </div>
  </div>

  <!-- Login content (hidden until auth state is known) -->
  <div id="login-content" class="hidden">
    <main class="flex min-h-[100dvh] flex-col items-center justify-center px-4">
      <div class="w-full max-w-sm animate-fade-in-up">
        <div class="glass-strong rounded-glass-xl p-8 text-center">
          <div class="mx-auto mb-6 flex h-16 w-16 items-center justify-center rounded-2xl bg-[var(--color-accent)]">
            <svg class="h-8 w-8 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 6v12m-3-2.818l.879.659c1.171.879 3.07.879 4.242 0 1.172-.879 1.172-2.303 0-3.182C13.536 12.219 12.768 12 12 12c-.725 0-1.45-.22-2.003-.659-1.106-.879-1.106-2.303 0-3.182s2.9-.879 4.006 0l.415.33M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
          </div>
          <h1 class="text-3xl font-bold">
            <span class="text-gradient">SplitMate</span>
          </h1>
          <p class="mt-2 text-sm text-[var(--color-text-secondary)]">
            Split expenses with friends. Track, calculate, and settle easily.
          </p>

          <div class="mt-8">
            <GlassButton id="google-signin" variant="primary" size="lg" fullWidth>
              <svg class="h-5 w-5" viewBox="0 0 24 24">
                <path fill="currentColor" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92a5.06 5.06 0 01-2.2 3.32v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.1z"/>
                <path fill="currentColor" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/>
                <path fill="currentColor" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z"/>
                <path fill="currentColor" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z"/>
              </svg>
              Sign in with Google
            </GlassButton>
          </div>

          <p class="mt-4 text-xs text-[var(--color-text-tertiary)]">
            No passwords. Secure Google authentication only.
          </p>
        </div>
      </div>
    </main>
  </div>

  <script>
    import { authInit, auth, signInWithGoogle } from "../lib/firebase";
    import { api } from "../lib/api";

    document.addEventListener("DOMContentLoaded", async () => {
      const firebaseUser = await authInit;

      if (firebaseUser) {
        try {
          const user = await api.auth.me();
          if (user.is_profile_complete) {
            window.location.href = "/dashboard";
            return;
          } else {
            window.location.href = "/complete-profile";
            return;
          }
        } catch (error: any) {
          console.error("Auth check failed:", error);
          await auth.signOut();
          (window as any).showToast?.({
            message: error.message || "Session expired. Please sign in again.",
            type: "error",
          });
        }
      }

      document.getElementById("loading-splash")?.classList.add("hidden");
      document.getElementById("login-content")?.classList.remove("hidden");

      document
        .getElementById("google-signin")
        ?.addEventListener("click", async () => {
          const btn = document.getElementById("google-signin");
          if (btn) {
            (btn as HTMLButtonElement).disabled = true;
            btn.textContent = "Signing in...";
          }

          try {
            await signInWithGoogle();
            const user = await api.auth.firebase();

            if (user.is_profile_complete) {
              window.location.href = "/dashboard";
            } else {
              window.location.href = "/complete-profile";
            }
          } catch (error: any) {
            (window as any).showToast?.({ message: error.message || "Sign in failed. Please try again.", type: "error" });
            if (btn) {
              (btn as HTMLButtonElement).disabled = false;
              btn.innerHTML = `<svg class="h-5 w-5" viewBox="0 0 24 24"><path fill="currentColor" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92a5.06 5.06 0 01-2.2 3.32v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.1z"/><path fill="currentColor" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/><path fill="currentColor" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z"/><path fill="currentColor" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z"/></svg> Sign in with Google`;
            }
          }
        });
    });
  </script>
</BaseLayout>
