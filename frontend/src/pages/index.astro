---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout>
  <main class="flex min-h-screen flex-col items-center justify-center px-4">
    <div class="w-full max-w-sm text-center">
      <div class="mb-8">
        <div class="mx-auto mb-4 flex h-16 w-16 items-center justify-center rounded-2xl bg-primary-600">
          <svg class="h-8 w-8 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
        </div>
        <h1 class="text-3xl font-bold text-gray-900">SplitMate</h1>
        <p class="mt-2 text-gray-600">
          Split expenses with friends. Track, calculate, and settle easily.
        </p>
      </div>

      <button
        id="google-signin"
        class="btn-primary w-full gap-2">
        <svg class="h-5 w-5" viewBox="0 0 24 24">
          <path fill="currentColor" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92a5.06 5.06 0 01-2.2 3.32v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.1z"/>
          <path fill="currentColor" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/>
          <path fill="currentColor" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z"/>
          <path fill="currentColor" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z"/>
        </svg>
        Sign in with Google
      </button>

      <p class="mt-4 text-xs text-gray-500">
        No passwords. Secure Google authentication only.
      </p>
    </div>
  </main>

  <script>
    import { signInWithGoogle } from "../lib/firebase";
    import { api } from "../lib/api";

    document
      .getElementById("google-signin")
      ?.addEventListener("click", async () => {
        const btn = document.getElementById("google-signin");
        if (btn) {
          btn.disabled = true;
          btn.textContent = "Signing in...";
        }

        try {
          await signInWithGoogle();
          const user = await api.auth.firebase();

          if (user.is_profile_complete) {
            window.location.href = "/dashboard";
          } else {
            window.location.href = "/complete-profile";
          }
        } catch (error: any) {
          alert(error.message || "Sign in failed. Please try again.");
          if (btn) {
            btn.disabled = false;
            btn.innerHTML = `... Sign in with Google`;
          }
        }
      });
  </script>
</BaseLayout>
