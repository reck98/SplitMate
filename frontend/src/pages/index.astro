              <svg class="h-5 w-5 text-[var(--color-accent)] shrink-0 transition-transform duration-200" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" /></svg>
            </button>
            <div class="p-4 sm:p-5 pt-0 text-xs sm:text-sm text-[var(--color-text-secondary)] leading-relaxed hidden">
              Yes, SplitMate is 100% free and open-source under the MIT license. There are no hidden fees, no daily transaction limits, and no premium paywalls.
            </div>
          </div>

          <!-- FAQ Item 2 -->
          <div class="glass-strong rounded-2xl border border-[var(--color-border)] overflow-hidden">
            <button class="w-full p-4 sm:p-5 text-left font-bold text-sm sm:text-base flex justify-between items-center text-[var(--color-text-primary)] faq-toggle min-h-[48px]">
              <span>How does the UPI QR Code Modal work in SplitMate?</span>
              <svg class="h-5 w-5 text-[var(--color-accent)] shrink-0 transition-transform duration-200" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" /></svg>
            </button>
            <div class="p-4 sm:p-5 pt-0 text-xs sm:text-sm text-[var(--color-text-secondary)] leading-relaxed hidden">
              Clicking <strong class="text-[var(--color-text-primary)]">Show QR</strong> opens a centered modal with a high-resolution QR code encoding standard <code class="text-xs font-mono bg-[var(--color-accent-soft)] px-1.5 py-0.5 rounded text-[var(--color-accent)]">upi://pay</code> parameters (recipient VPA, amount, currency, note). Any mobile UPI application (PhonePe, Google Pay, Paytm, CRED) can scan the QR code instantly. You can also copy the recipient's UPI ID or download the QR code as a crisp PNG image.
            </div>
          </div>

          <!-- FAQ Item 3 -->
          <div class="glass-strong rounded-2xl border border-[var(--color-border)] overflow-hidden">
            <button class="w-full p-4 sm:p-5 text-left font-bold text-sm sm:text-base flex justify-between items-center text-[var(--color-text-primary)] faq-toggle min-h-[48px]">
              <span>Do my friends need to download an app to join?</span>
              <svg class="h-5 w-5 text-[var(--color-accent)] shrink-0 transition-transform duration-200" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" /></svg>
            </button>
            <div class="p-4 sm:p-5 pt-0 text-xs sm:text-sm text-[var(--color-text-secondary)] leading-relaxed hidden">
              No! SplitMate is built as a Progressive Web App (PWA). Friends can open your group invite link in any browser on Android or iOS and start logging expenses instantly with 1-click Google Sign-In.
            </div>
          </div>

          <!-- FAQ Item 4 -->
          <div class="glass-strong rounded-2xl border border-[var(--color-border)] overflow-hidden">
            <button class="w-full p-4 sm:p-5 text-left font-bold text-sm sm:text-base flex justify-between items-center text-[var(--color-text-primary)] faq-toggle min-h-[48px]">
              <span>Does SplitMate store my bank account or credit card info?</span>
              <svg class="h-5 w-5 text-[var(--color-accent)] shrink-0 transition-transform duration-200" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" /></svg>
            </button>
            <div class="p-4 sm:p-5 pt-0 text-xs sm:text-sm text-[var(--color-text-secondary)] leading-relaxed hidden">
              Never. SplitMate only saves your public UPI ID (VPA) so friends can pay you directly. Money transfers happen entirely inside your standard PhonePe, Google Pay, or Paytm app.
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- FINAL CALL TO ACTION BANNER -->
    <section class="relative z-10 py-14 sm:py-20 px-4 sm:px-6 lg:px-8">
      <div class="mx-auto max-w-5xl">
        <div class="relative glass-strong rounded-3xl p-6 sm:p-14 border border-[var(--color-accent-soft)] shadow-2xl text-center overflow-hidden glow-card">
          <div class="absolute -top-24 -right-24 h-64 w-64 rounded-full bg-[var(--color-accent-soft)] blur-3xl"></div>
          <div class="absolute -bottom-24 -left-24 h-64 w-64 rounded-full bg-teal-500/10 blur-3xl"></div>

          <h2 class="text-2xl sm:text-5xl font-black tracking-tight text-[var(--color-text-primary)]">
            Ready to Eliminate Awkward Expense Tracking?
          </h2>
          <p class="mt-3 sm:mt-4 text-xs sm:text-lg text-[var(--color-text-secondary)] max-w-2xl mx-auto">
            Join thousands of Indian roommates, road-trippers, and friends splitting bills effortless and settling with 1-click UPI.
          </p>

          <div class="mt-6 sm:mt-8 flex justify-center">
            <button
              data-action="signin"
              class="w-full sm:w-auto min-h-[48px] inline-flex items-center justify-center gap-3 rounded-2xl bg-[var(--color-accent)] px-6 sm:px-8 py-3.5 sm:py-4 text-sm sm:text-base font-bold text-white shadow-xl shadow-[var(--color-accent-soft)] hover:bg-[var(--color-accent-hover)] hover:scale-105 active:scale-95 transition-all duration-200"
            >
              <svg class="h-5 w-5 shrink-0" viewBox="0 0 24 24">
                <path fill="currentColor" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92a5.06 5.06 0 01-2.2 3.32v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.1z"/>
                <path fill="currentColor" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/>
                <path fill="currentColor" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z"/>
                <path fill="currentColor" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z"/>
              </svg>
              <span>Get Started Free with Google</span>
            </button>
          </div>
        </div>
      </div>
    </section>

    <!-- FOOTER -->
    <footer class="relative z-10 border-t border-[var(--color-border)] bg-[var(--color-bg-elevated)] py-8 sm:py-12 px-4 sm:px-6 lg:px-8">
      <div class="mx-auto max-w-7xl flex flex-col md:flex-row items-center justify-between gap-4 sm:gap-6 text-center md:text-left">
        <div class="flex flex-col sm:flex-row items-center gap-2 sm:gap-2.5">
          <div class="flex items-center gap-2">
            <div class="flex h-7 w-7 items-center justify-center rounded-lg bg-[var(--color-accent)] text-white text-xs font-bold">
              S
            </div>
            <span class="text-base sm:text-lg font-bold text-gradient">SplitMate</span>
          </div>
          <span class="text-[11px] sm:text-xs text-[var(--color-text-tertiary)]">© 2026 SplitMate. Open Source under MIT.</span>
        </div>

        <div class="flex flex-wrap justify-center items-center gap-4 sm:gap-6 text-xs text-[var(--color-text-secondary)]">
          <a href="#features" class="hover:text-[var(--color-accent)] transition-colors">Features</a>
          <a href="#how-it-works" class="hover:text-[var(--color-accent)] transition-colors">How It Works</a>
          <a href="#calculator" class="hover:text-[var(--color-accent)] transition-colors">Simulator</a>
          <a href="https://github.com/reck98/SplitMate" target="_blank" rel="noopener noreferrer" class="hover:text-[var(--color-accent)] transition-colors">GitHub</a>
        </div>
      </div>
    </footer>

    <!-- TEST UPI MODAL PREVIEW (Interactive Modal) -->
    <div id="test-upi-modal" class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/60 backdrop-blur-sm hidden animate-fade-in">
      <div class="glass-strong rounded-3xl p-5 sm:p-6 max-w-md w-full border border-[var(--color-accent-soft)] space-y-4 animate-scale-in">
        <div class="flex justify-between items-center pb-2 border-b border-[var(--color-border)]">
          <h3 class="font-bold text-sm sm:text-base text-[var(--color-text-primary)] flex items-center gap-2">
            <span>⚡ Simulated UPI Payload</span>
          </h3>
          <button id="close-upi-modal" class="text-[var(--color-text-tertiary)] hover:text-[var(--color-text-primary)] text-xl p-1">&times;</button>
        </div>

        <p class="text-xs text-[var(--color-text-secondary)]">
          In SplitMate, clicking settle invokes a native deep link protocol like this:
        </p>

        <div class="glass p-3 rounded-xl font-mono text-[11px] sm:text-xs break-all text-[var(--color-accent)] bg-[var(--color-accent-soft)]" id="upi-payload-text">
          upi://pay?pa=rahul@upi&pn=Rahul%20Sharma&am=1200.00&cu=INR
        </div>

        <div class="flex flex-col xs:flex-row justify-end gap-2 pt-2">
          <button id="copy-upi-btn" class="glass rounded-xl px-4 py-2.5 text-xs font-bold text-[var(--color-text-primary)] hover:bg-[var(--color-bg-glass-hover)] transition-all">
            Copy Link
          </button>
          <button data-action="signin" class="rounded-xl bg-[var(--color-accent)] px-4 py-2.5 text-xs font-bold text-white hover:bg-[var(--color-accent-hover)] transition-all">
            Try Full App Free
          </button>
        </div>
      </div>
    </div>
  </div>

  <script>
    import { authInit, auth, signInWithGoogle } from "../lib/firebase";
    import { api } from "../lib/api";
    import { onDOMReady } from "../lib/dom";

    onDOMReady(async () => {
      // 1. Auth Check & Auto Redirect
      const firebaseUser = await authInit;

      if (firebaseUser) {
        try {
          const user = await api.auth.me();
          if (user.is_profile_complete) {
            window.location.href = "/dashboard";
            return;
          } else {
            window.location.href = "/complete-profile";
            return;
          }
        } catch (error: any) {
          console.error("Auth check failed:", error);
          await auth.signOut();
          (window as any).showToast?.({
            message: error.message || "Session expired. Please sign in again.",
            type: "error",
          });
        }
      }

      // Hide loading splash and reveal SaaS Landing Page
      document.getElementById("loading-splash")?.classList.add("hidden");
      document.getElementById("landing-content")?.classList.remove("hidden");

      // 2. Mobile Menu Toggle Handler
      const menuToggle = document.getElementById("mobile-menu-toggle");
      const mobileDrawer = document.getElementById("mobile-drawer");
      const hamburgerIcon = document.getElementById("hamburger-icon");
      const closeIcon = document.getElementById("close-icon");

      menuToggle?.addEventListener("click", () => {
        const isOpened = !mobileDrawer?.classList.contains("hidden");
        if (isOpened) {
          mobileDrawer?.classList.add("hidden");
          hamburgerIcon?.classList.remove("hidden");
          closeIcon?.classList.add("hidden");
        } else {
          mobileDrawer?.classList.remove("hidden");
          hamburgerIcon?.classList.add("hidden");
          closeIcon?.classList.remove("hidden");
        }
      });

      // Close mobile drawer when clicking any link inside drawer
      document.querySelectorAll(".mobile-nav-link").forEach((link) => {
        link.addEventListener("click", () => {
          mobileDrawer?.classList.add("hidden");
          hamburgerIcon?.classList.remove("hidden");
          closeIcon?.classList.add("hidden");
        });
      });

      // 3. Google Sign-In Trigger Handler
      const handleSignIn = async () => {
        const buttons = document.querySelectorAll('[data-action="signin"]');
        buttons.forEach((btn) => {
          (btn as HTMLButtonElement).disabled = true;
          btn.textContent = "Signing in...";
        });

        try {
          await signInWithGoogle();
          const user = await api.auth.firebase();

          if (user.is_profile_complete) {
            window.location.href = "/dashboard";
          } else {
            window.location.href = "/complete-profile";
          }
        } catch (error: any) {
          (window as any).showToast?.({
            message: error.message || "Sign in failed. Please try again.",
            type: "error",
          });
          buttons.forEach((btn) => {
            (btn as HTMLButtonElement).disabled = false;
            btn.innerHTML = `<svg class="h-4 w-4 shrink-0" viewBox="0 0 24 24"><path fill="currentColor" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92a5.06 5.06 0 01-2.2 3.32v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.1z"/><path fill="currentColor" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/><path fill="currentColor" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z"/><path fill="currentColor" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z"/></svg><span>Sign In</span>`;
          });
        }
      };

      document.querySelectorAll('[data-action="signin"]').forEach((btn) => {
        btn.addEventListener("click", handleSignIn);
      });

      // 4. Mockup Tab Switcher logic
      const tabBtns = document.querySelectorAll("#mock-tabs button");
      tabBtns.forEach((btn) => {
        btn.addEventListener("click", () => {
          const tab = btn.getAttribute("data-tab");
          tabBtns.forEach((b) => {
            b.classList.remove("bg-[var(--color-accent)]", "text-white", "shadow-sm");
            b.classList.add("hover:bg-[var(--color-bg-glass-hover)]");
          });
          btn.classList.add("bg-[var(--color-accent)]", "text-white", "shadow-sm");
          btn.classList.remove("hover:bg-[var(--color-bg-glass-hover)]");

          document.getElementById("tab-content-balances")?.classList.add("hidden");
          document.getElementById("tab-content-expenses")?.classList.add("hidden");
          document.getElementById("tab-content-upi")?.classList.add("hidden");

          if (tab === "balances") document.getElementById("tab-content-balances")?.classList.remove("hidden");
          if (tab === "expenses") document.getElementById("tab-content-expenses")?.classList.remove("hidden");
          if (tab === "upi") document.getElementById("tab-content-upi")?.classList.remove("hidden");
        });
      });

      // Mock UPI buttons inside hero showcase trigger test modal
      document.querySelectorAll(".mock-upi-btn").forEach((btn) => {
        btn.addEventListener("click", () => {
          const modal = document.getElementById("test-upi-modal");
          modal?.classList.remove("hidden");
        });
      });

      // 5. Live Calculator Widget Interactive Logic
      const calcAmountInput = document.getElementById("calc-amount") as HTMLInputElement;
      const calcFriendsRange = document.getElementById("calc-friends") as HTMLInputElement;
      const calcFriendsVal = document.getElementById("calc-friends-val");
      const calcPerPerson = document.getElementById("calc-per-person");
      const calcOldTransfers = document.getElementById("calc-old-transfers");
      const calcNewTransfers = document.getElementById("calc-new-transfers");
      const upiPayloadText = document.getElementById("upi-payload-text");

      function updateCalculator() {
        if (!calcAmountInput || !calcFriendsRange) return;
        const amount = parseFloat(calcAmountInput.value) || 0;
        const friends = parseInt(calcFriendsRange.value) || 2;

        if (calcFriendsVal) calcFriendsVal.textContent = `${friends} Friends`;

        const perPerson = amount > 0 ? (amount / friends).toFixed(2) : "0.00";
        if (calcPerPerson) calcPerPerson.textContent = `₹${parseFloat(perPerson).toLocaleString("en-IN", { minimumFractionDigits: 2 })}`;

        const n = friends;
        const oldT = n * (n - 1) / 2;
        const newT = Math.max(1, n - 1);

        if (calcOldTransfers) calcOldTransfers.textContent = `${oldT} transfers`;
        if (calcNewTransfers) calcNewTransfers.textContent = `⚡ ${newT} direct UPI transfers`;

        if (upiPayloadText) {
          upiPayloadText.textContent = `upi://pay?pa=friend@upi&pn=Friend&am=${perPerson}&cu=INR`;
        }
      }

      calcAmountInput?.addEventListener("input", updateCalculator);
      calcFriendsRange?.addEventListener("input", updateCalculator);

      // Category buttons in simulator
      document.querySelectorAll("#calc-category button").forEach((catBtn) => {
        catBtn.addEventListener("click", () => {
          document.querySelectorAll("#calc-category button").forEach((b) => {
            b.className = "py-2.5 rounded-xl glass hover:bg-[var(--color-bg-glass-hover)] text-center";
          });
          catBtn.className = "py-2.5 rounded-xl border border-[var(--color-accent)] bg-[var(--color-accent-soft)] text-[var(--color-accent)] font-bold text-center";
        });
      });

      // 6. Test UPI Modal logic
      const testUpiBtn = document.getElementById("calc-test-btn");
      const modal = document.getElementById("test-upi-modal");
      const closeUpiModal = document.getElementById("close-upi-modal");
      const copyUpiBtn = document.getElementById("copy-upi-btn");

      testUpiBtn?.addEventListener("click", () => {
        modal?.classList.remove("hidden");
      });

      closeUpiModal?.addEventListener("click", () => {
        modal?.classList.add("hidden");
      });

      modal?.addEventListener("click", (e) => {
        if (e.target === modal) modal.classList.add("hidden");
      });

      copyUpiBtn?.addEventListener("click", () => {
        const text = upiPayloadText?.textContent || "";
        navigator.clipboard.writeText(text);
        (window as any).showToast?.({ message: "UPI Link copied to clipboard!", type: "success" });
      });

      // 7. FAQ Accordion Toggle
      const faqToggles = document.querySelectorAll(".faq-toggle");
      faqToggles.forEach((btn) => {
        btn.addEventListener("click", () => {
          const content = btn.nextElementSibling;
          const icon = btn.querySelector("svg");
          if (content) {
            const isHidden = content.classList.contains("hidden");
            content.classList.toggle("hidden");
            if (icon) {
              icon.style.transform = isHidden ? "rotate(180deg)" : "rotate(0deg)";
            }
          }
        });
      });
    });
  </script>
</BaseLayout>
