---
import BaseLayout from "../layouts/BaseLayout.astro";
import ThemeToggle from "../components/ThemeToggle.astro";
---

<BaseLayout hideNav title="SplitMate — Smart, Instant & Free Expense Sharing for India" description="Split group expenses, track balances, and settle debts instantly via UPI with zero payment gateway fees. Crafted for trips, flatmates, and group events.">
  <!-- Loading splash (visible while auth initializes) -->
  <div id="loading-splash" class="fixed inset-0 z-50 flex items-center justify-center bg-[var(--color-bg)]">
    <div class="flex flex-col items-center gap-3">
      <div class="h-10 w-10 animate-spin rounded-full border-4 border-[var(--color-accent)] border-t-transparent"></div>
      <p class="text-sm font-medium text-[var(--color-text-secondary)]">Loading SplitMate...</p>
    </div>
  </div>

  <!-- Main SaaS Landing Page Content (Hidden until guest state confirmed) -->
  <div id="landing-content" class="hidden min-h-screen relative overflow-hidden bg-grid-pattern">
    <div class="hero-glow"></div>

    <!-- Top Announcement Bar -->
    <div class="relative z-40 border-b border-[var(--color-border)] bg-[var(--color-accent-soft)] py-2 px-3 sm:px-4 text-center text-[11px] sm:text-xs font-medium text-[var(--color-text-primary)]">
      <div class="mx-auto flex max-w-7xl items-center justify-center gap-1.5 sm:gap-2 flex-wrap sm:flex-nowrap">
        <span class="inline-flex items-center rounded-full bg-[var(--color-accent)] px-2 py-0.5 text-[9px] sm:text-[10px] font-bold text-white uppercase tracking-wider shrink-0">New</span>
        <span>SplitMate 2.0 is Live! Show QR Payment Modal & Real-Time Sync.</span>
        <a href="#calculator" class="ml-1 text-[var(--color-accent)] underline hover:opacity-80 transition-opacity font-semibold shrink-0">Try Simulator &rarr;</a>
      </div>
    </div>

    <!-- Header Navbar -->
    <header class="sticky top-0 z-40 backdrop-blur-xl bg-[var(--color-bg-elevated)] border-b border-[var(--color-border)] transition-all">
      <div class="mx-auto flex max-w-7xl items-center justify-between px-4 sm:px-6 lg:px-8 py-3">
        <!-- Logo -->
        <a href="/" class="flex items-center gap-2.5 group">
          <div class="flex h-9 w-9 items-center justify-center rounded-xl bg-[var(--color-accent)] text-white shadow-md shadow-[var(--color-accent-soft)] transition-transform duration-200 group-hover:scale-105">
            <svg class="h-5 w-5 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 6v12m-3-2.818l.879.659c1.171.879 3.07.879 4.242 0 1.172-.879 1.172-2.303 0-3.182C13.536 12.219 12.768 12 12 12c-.725 0-1.45-.22-2.003-.659-1.106-.879-1.106-2.303 0-3.182s2.9-.879 4.006 0l.415.33M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
          </div>
          <span class="text-xl font-extrabold tracking-tight">
            <span class="text-gradient">SplitMate</span>
          </span>
        </a>

        <!-- Desktop Navigation Links -->
        <nav class="hidden md:flex items-center gap-8 text-sm font-medium text-[var(--color-text-secondary)]">
          <a href="#features" class="hover:text-[var(--color-text-primary)] transition-colors">Features</a>
          <a href="#how-it-works" class="hover:text-[var(--color-text-primary)] transition-colors">How It Works</a>
          <a href="#calculator" class="hover:text-[var(--color-text-primary)] transition-colors">Split Simulator</a>
          <a href="#comparison" class="hover:text-[var(--color-text-primary)] transition-colors">Why SplitMate</a>
          <a href="#faq" class="hover:text-[var(--color-text-primary)] transition-colors">FAQ</a>
        </nav>

        <!-- Header Actions -->
        <div class="flex items-center gap-2 sm:gap-3">
          <ThemeToggle />

          <a
            href="https://github.com/reck98/SplitMate"
            target="_blank"
            rel="noopener noreferrer"
            class="hidden sm:inline-flex items-center gap-1.5 glass rounded-full px-3.5 py-1.5 text-xs font-semibold text-[var(--color-text-secondary)] hover:text-[var(--color-text-primary)] hover:scale-105 active:scale-95 transition-all duration-200"
            title="Open Source Repository"
          >
            <svg class="h-4 w-4 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"></path>
              <path d="M9 18c-4.51 2-5-2-7-2"></path>
            </svg>
            <span>GitHub</span>
          </a>

          <!-- Sign In Button -->
          <button
            data-action="signin"
            class="inline-flex items-center gap-2 rounded-xl bg-[var(--color-accent)] px-3.5 sm:px-4 py-2 text-xs sm:text-sm font-semibold text-white shadow-sm hover:bg-[var(--color-accent-hover)] active:scale-95 transition-all duration-200"
          >
            <svg class="h-4 w-4" viewBox="0 0 24 24">
              <path fill="currentColor" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92a5.06 5.06 0 01-2.2 3.32v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.1z"/>
              <path fill="currentColor" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/>
              <path fill="currentColor" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z"/>
              <path fill="currentColor" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z"/>
            </svg>
            <span>Sign In</span>
          </button>

          <!-- Mobile Hamburger Toggle Button -->
          <button
            id="mobile-menu-toggle"
            class="md:hidden glass rounded-xl p-2 text-[var(--color-text-secondary)] hover:text-[var(--color-text-primary)] transition-all"
            aria-label="Toggle navigation menu"
          >
            <svg id="hamburger-icon" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
            </svg>
            <svg id="close-icon" class="h-5 w-5 hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
            </svg>
          </button>
        </div>
      </div>

      <!-- Mobile Navigation Drawer -->
      <div id="mobile-drawer" class="hidden md:hidden backdrop-blur-2xl bg-[var(--color-bg-elevated)] border-b border-[var(--color-border)] p-4 shadow-2xl space-y-2 animate-fade-in-down">
        <div class="flex items-center justify-between py-2 px-4 border-b border-[var(--color-border)] mb-2">
          <span class="text-xs font-semibold text-[var(--color-text-secondary)]">Appearance</span>
          <ThemeToggle />
        </div>
        <a href="#features" class="mobile-nav-link block py-2.5 px-4 rounded-xl text-sm font-semibold text-[var(--color-text-primary)] hover:bg-[var(--color-bg-glass-hover)] transition-all">
          Features
        </a>
        <a href="#how-it-works" class="mobile-nav-link block py-2.5 px-4 rounded-xl text-sm font-semibold text-[var(--color-text-primary)] hover:bg-[var(--color-bg-glass-hover)] transition-all">
          How It Works
        </a>
        <a href="#calculator" class="mobile-nav-link block py-2.5 px-4 rounded-xl text-sm font-semibold text-[var(--color-text-primary)] hover:bg-[var(--color-bg-glass-hover)] transition-all">
          Split Simulator
        </a>
        <a href="#comparison" class="mobile-nav-link block py-2.5 px-4 rounded-xl text-sm font-semibold text-[var(--color-text-primary)] hover:bg-[var(--color-bg-glass-hover)] transition-all">
          Why SplitMate
        </a>
        <a href="#faq" class="mobile-nav-link block py-2.5 px-4 rounded-xl text-sm font-semibold text-[var(--color-text-primary)] hover:bg-[var(--color-bg-glass-hover)] transition-all">
          FAQ
        </a>
      </div>
    </header>

    <!-- HERO SECTION -->
    <section class="relative z-10 pt-10 pb-16 sm:pt-20 sm:pb-28 px-4 sm:px-6 lg:px-8">
      <div class="mx-auto max-w-5xl text-center">
        <!-- Hero Pill Badge -->
        <div class="inline-flex items-center gap-2 rounded-full glass px-3.5 py-1.5 mb-6 sm:mb-8 text-[11px] sm:text-xs font-semibold text-[var(--color-accent)] border border-[var(--color-accent-soft)] shadow-sm animate-fade-in-down">
          <span class="flex h-2 w-2 rounded-full bg-[var(--color-accent)] badge-pulse"></span>
          <span>Built for India • Zero Payment Gateway Fees • Show QR Code Modal</span>
        </div>

        <!-- Hero Headline -->
        <h1 class="text-3xl xs:text-4xl sm:text-6xl lg:text-7xl font-extrabold tracking-tight leading-[1.18] sm:leading-[1.12]">
          Expense Sharing for India.<br />
          <span class="text-gradient">Settle via UPI Instantly.</span>
        </h1>

        <!-- Hero Subheadline -->
        <p class="mt-4 sm:mt-6 text-sm sm:text-xl text-[var(--color-text-secondary)] max-w-3xl mx-auto font-normal leading-relaxed">
          Track group bills, preserve clear expense obligations, and settle up directly using 
          <strong class="text-[var(--color-text-primary)] font-semibold">PhonePe, Google Pay, or Paytm</strong> — with zero commissions or payment gateway middleman.
        </p>

        <!-- Hero CTA Action Group -->
        <div class="mt-8 sm:mt-10 flex flex-col sm:flex-row items-center justify-center gap-3.5 sm:gap-4 max-w-md mx-auto sm:max-w-none">
          <button
            data-action="signin"
            class="w-full sm:w-auto min-h-[48px] inline-flex items-center justify-center gap-3 rounded-2xl bg-[var(--color-accent)] px-6 sm:px-8 py-3.5 sm:py-4 text-sm sm:text-base font-bold text-white shadow-lg shadow-[var(--color-accent-soft)] hover:bg-[var(--color-accent-hover)] hover:scale-[1.02] active:scale-[0.98] transition-all duration-200"
          >
            <svg class="h-5 w-5 shrink-0" viewBox="0 0 24 24">
              <path fill="currentColor" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92a5.06 5.06 0 01-2.2 3.32v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.1z"/>
              <path fill="currentColor" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/>
              <path fill="currentColor" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z"/>
              <path fill="currentColor" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z"/>
            </svg>
            <span>Get Started Free with Google</span>
          </button>

          <a
            href="#calculator"
            class="w-full sm:w-auto min-h-[48px] inline-flex items-center justify-center gap-2 glass glass-hover rounded-2xl px-6 sm:px-7 py-3.5 sm:py-4 text-sm sm:text-base font-semibold text-[var(--color-text-primary)] transition-all duration-200"
          >
            <svg class="h-5 w-5 text-[var(--color-accent)] shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M14.752 11.168l-3.197-2.132A1 1 0 0010 9.87v4.263a1 1 0 001.555.832l3.197-2.132a1 1 0 000-1.664z" />
              <path stroke-linecap="round" stroke-linejoin="round" d="M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
            <span>Try Interactive Splitter</span>
          </a>
        </div>

        <!-- Trust Badges Bar -->
        <div class="mt-10 sm:mt-12 flex flex-wrap items-center justify-center gap-4 sm:gap-6 text-xs font-semibold text-[var(--color-text-secondary)]">
          <div class="flex items-center gap-1.5">
            <svg class="h-4 w-4 text-[var(--color-accent)] shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" /></svg>
            <span>100% Free Forever</span>
          </div>
          <div class="flex items-center gap-1.5">
            <svg class="h-4 w-4 text-[var(--color-accent)] shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" /></svg>
            <span>Instant Scannable UPI QR</span>
          </div>
          <div class="flex items-center gap-1.5">
            <svg class="h-4 w-4 text-[var(--color-accent)] shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" /></svg>
            <span>No Passwords Needed</span>
          </div>
          <div class="flex items-center gap-1.5">
            <svg class="h-4 w-4 text-[var(--color-accent)] shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" /></svg>
            <span>Sub-10ms Live Sync</span>
          </div>
        </div>

        <!-- HERO APP SHOWCASE MOCKUP -->
        <div class="mt-10 sm:mt-14 relative max-w-4xl mx-auto">
          <!-- Ambient Card Glow -->
          <div class="absolute -inset-1 rounded-3xl bg-gradient-to-r from-[var(--color-accent)] to-teal-400 opacity-20 blur-xl"></div>
          
          <div class="relative glass-strong rounded-3xl border border-[var(--color-border)] p-3.5 sm:p-6 shadow-2xl text-left overflow-hidden">
            <!-- Mock Header -->
            <div class="flex flex-wrap items-center justify-between gap-2 pb-3.5 border-b border-[var(--color-border)]">
              <div class="flex items-center gap-2.5">
                <div class="flex h-9 w-9 sm:h-10 sm:w-10 items-center justify-center rounded-2xl bg-gradient-to-br from-emerald-500 to-teal-600 text-white font-bold text-base sm:text-lg shrink-0">
                  🌴
                </div>
                <div>
                  <h3 class="font-bold text-sm sm:text-lg text-[var(--color-text-primary)]">Goa Trip 2026</h3>
                  <p class="text-[11px] sm:text-xs text-[var(--color-text-tertiary)]">4 Members • Live Sync</p>
                </div>
              </div>

              <!-- Share Badge -->
              <div class="flex items-center gap-2 ml-auto">
                <span class="hidden sm:inline-flex items-center gap-1 rounded-full bg-[var(--color-accent-soft)] px-3 py-1 text-xs font-semibold text-[var(--color-accent)]">
                  <span class="h-1.5 w-1.5 rounded-full bg-[var(--color-accent)] animate-ping"></span>
                  SSE Active
                </span>
                <span class="glass rounded-xl px-2.5 sm:px-3 py-1 text-[11px] sm:text-xs font-mono font-medium text-[var(--color-text-secondary)]">
                  Code: <strong class="text-[var(--color-accent)] font-bold">GOA98X</strong>
                </span>
              </div>
            </div>

            <!-- Tab Switcher -->
            <div class="flex gap-1.5 my-3 p-1 glass rounded-xl text-xs font-semibold text-[var(--color-text-secondary)]" id="mock-tabs">
              <button class="flex-1 py-2 px-1 rounded-lg bg-[var(--color-accent)] text-white shadow-sm transition-all text-center" data-tab="balances">
                <span class="hidden sm:inline">Balances Summary</span>
                <span class="sm:hidden">Balances</span>
              </button>
              <button class="flex-1 py-2 px-1 rounded-lg hover:bg-[var(--color-bg-glass-hover)] transition-all text-center" data-tab="expenses">
                <span class="hidden sm:inline">Recent Bills</span>
                <span class="sm:hidden">Bills</span>
              </button>
              <button class="flex-1 py-2 px-1 rounded-lg hover:bg-[var(--color-bg-glass-hover)] transition-all text-center" data-tab="upi">
                <span class="hidden sm:inline">Show UPI QR</span>
                <span class="sm:hidden">Show QR</span>
              </button>
            </div>

            <!-- Mock Tab Content: Balances -->
            <div id="tab-content-balances" class="space-y-3 py-1">
              <div class="glass p-3.5 sm:p-4 rounded-2xl flex flex-col xs:flex-row xs:items-center justify-between gap-2 bg-gradient-to-r from-[var(--color-accent-soft)] to-transparent">
                <div>
                  <p class="text-[10px] sm:text-xs text-[var(--color-text-tertiary)] uppercase font-semibold tracking-wider">Your Net Balance</p>
                  <p class="text-xl sm:text-2xl font-black text-[var(--color-accent)] mt-0.5">+₹3,400.00</p>
                </div>
                <span class="inline-flex items-center gap-1 rounded-full bg-[var(--color-accent)] px-2.5 py-1 text-[11px] sm:text-xs font-bold text-white shadow-sm w-fit">
                  You are owed money
                </span>
              </div>

              <!-- Member list -->
              <div class="grid grid-cols-1 sm:grid-cols-3 gap-2.5 pt-1">
                <div class="glass p-3 rounded-xl flex items-center gap-3">
                  <div class="h-8 w-8 rounded-full bg-emerald-500/20 text-[var(--color-accent)] font-bold flex items-center justify-center text-xs shrink-0">R</div>
                  <div>
                    <p class="text-xs font-bold text-[var(--color-text-primary)]">Rahul Sharma</p>
                    <p class="text-[11px] text-rose-500 font-semibold">Owes ₹1,200</p>
                  </div>
                </div>

                <div class="glass p-3 rounded-xl flex items-center gap-3">
                  <div class="h-8 w-8 rounded-full bg-teal-500/20 text-teal-500 font-bold flex items-center justify-center text-xs shrink-0">A</div>
                  <div>
                    <p class="text-xs font-bold text-[var(--color-text-primary)]">Ananya Roy</p>
                    <p class="text-[11px] text-rose-500 font-semibold">Owes ₹2,200</p>
                  </div>
                </div>

                <div class="glass p-3 rounded-xl flex items-center gap-3">
                  <div class="h-8 w-8 rounded-full bg-indigo-500/20 text-indigo-500 font-bold flex items-center justify-center text-xs shrink-0">V</div>
                  <div>
                    <p class="text-xs font-bold text-[var(--color-text-primary)]">Vikram Singh</p>
                    <p class="text-[11px] text-[var(--color-accent)] font-semibold">Settled (₹0)</p>
                  </div>
                </div>
              </div>
            </div>

            <!-- Mock Tab Content: Recent Bills (Hidden initially) -->
            <div id="tab-content-expenses" class="hidden space-y-2 py-1">
              <div class="glass p-3 rounded-xl flex items-center justify-between text-xs">
                <div class="flex items-center gap-2.5">
                  <span class="text-base">🏡</span>
                  <div>
                    <p class="font-bold text-[var(--color-text-primary)]">Beach Villa Booking</p>
                    <p class="text-[11px] text-[var(--color-text-tertiary)]">Paid by You • Equal split</p>
                  </div>
                </div>
                <span class="font-bold text-[var(--color-text-primary)]">₹16,000</span>
              </div>

              <div class="glass p-3 rounded-xl flex items-center justify-between text-xs">
                <div class="flex items-center gap-2.5">
                  <span class="text-base">🦀</span>
                  <div>
                    <p class="font-bold text-[var(--color-text-primary)]">Seafood Shack Dinner</p>
                    <p class="text-[11px] text-[var(--color-text-tertiary)]">Paid by Rahul • Equal split</p>
                  </div>
                </div>
                <span class="font-bold text-[var(--color-text-primary)]">₹5,200</span>
              </div>
            </div>

            <!-- Mock Tab Content: UPI Pay (Hidden initially) -->
            <div id="tab-content-upi" class="hidden space-y-3 py-1">
              <div class="glass p-3.5 sm:p-4 rounded-2xl flex flex-col sm:flex-row sm:items-center justify-between gap-3 border border-[var(--color-accent-soft)]">
                <div>
                  <p class="text-[11px] text-[var(--color-text-tertiary)]">Settlement Transfer</p>
                  <p class="text-xs sm:text-sm font-bold text-[var(--color-text-primary)]">Rahul Sharma &rarr; You</p>
                  <p class="text-xs text-[var(--color-accent)] font-semibold mt-0.5">Amount: ₹1,200.00</p>
                </div>
                <div class="flex flex-wrap items-center gap-2">
                  <button class="mock-upi-btn flex-1 sm:flex-initial glass hover:border-emerald-500 rounded-xl px-3 py-2 text-xs font-bold text-[var(--color-accent)] flex items-center justify-center gap-1 transition-all">
                    <span>⚡ PhonePe</span>
                  </button>
                  <button class="mock-upi-btn flex-1 sm:flex-initial glass hover:border-blue-500 rounded-xl px-3 py-2 text-xs font-bold text-blue-500 flex items-center justify-center gap-1 transition-all">
                    <span>⚡ GPay</span>
                  </button>
                  <button class="mock-upi-btn flex-1 sm:flex-initial glass hover:border-sky-500 rounded-xl px-3 py-2 text-xs font-bold text-sky-500 flex items-center justify-center gap-1 transition-all">
                    <span>⚡ Paytm</span>
                  </button>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- STATS STRIP -->
    <section class="relative z-10 border-y border-[var(--color-border)] bg-[var(--color-bg-elevated)] py-6 sm:py-8">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <div class="grid grid-cols-2 md:grid-cols-4 gap-4 sm:gap-6 text-center">
          <div class="p-2">
            <p class="text-2xl sm:text-4xl font-extrabold text-[var(--color-accent)]">0%</p>
            <p class="mt-0.5 text-[11px] sm:text-sm font-medium text-[var(--color-text-secondary)]">Payment Gateway Fees</p>
          </div>
          <div class="p-2">
            <p class="text-2xl sm:text-4xl font-extrabold text-[var(--color-text-primary)]">&lt; 10ms</p>
            <p class="mt-0.5 text-[11px] sm:text-sm font-medium text-[var(--color-text-secondary)]">Client SWR Sync Speed</p>
          </div>
          <div class="p-2">
