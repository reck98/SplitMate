---
import BaseLayout from "../layouts/BaseLayout.astro";
import GlassButton from "../components/GlassButton.astro";
---

<BaseLayout title="Join Group - SplitMate">
  <main class="mx-auto max-w-2xl px-4 py-6">
    <header class="mb-6 animate-fade-in-down">
      <a href="/dashboard" class="inline-flex items-center gap-1.5 text-sm text-[var(--color-text-secondary)] hover:text-[var(--color-accent)] transition-colors mb-4">
        <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 19.5L8.25 12l7.5-7.5" />
        </svg>
        Back to Dashboard
      </a>
      <h1 class="text-3xl font-bold text-[var(--color-text-primary)]">Join Group</h1>
      <p class="mt-1 text-sm text-[var(--color-text-secondary)]">
        Enter the invite code shared by a friend.
      </p>
    </header>

    <div class="glass-strong rounded-glass-xl p-6 animate-fade-in-up">
      <form id="join-group-form" class="space-y-4">
        <div>
          <label for="invite_code" class="block text-sm font-medium text-[var(--color-text-secondary)] mb-1.5">
            Invite Code
          </label>
          <input
            type="text"
            id="invite_code"
            name="invite_code"
            placeholder="e.g., A82DKP"
            required
            maxlength="6"
            autocomplete="off"
            style="letter-spacing: 0.25em; font-family: var(--font-mono); text-transform: uppercase;"
          />
          <p class="mt-1.5 text-xs text-[var(--color-text-tertiary)]">
            Ask the group creator for the 6-character invite code.
          </p>
        </div>

        <GlassButton type="submit" variant="primary" size="lg" fullWidth>
          <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 6a3.75 3.75 0 11-7.5 0 3.75 3.75 0 017.5 0zM4.501 20.118a7.5 7.5 0 0114.998 0A17.933 17.933 0 0112 21.75c-2.676 0-5.216-.584-7.499-1.632z" />
          </svg>
          Join Group
        </GlassButton>
      </form>
    </div>
  </main>

  <script>
    import { api } from "../lib/api";
    import { authInit } from "../lib/firebase";

    document.addEventListener("DOMContentLoaded", async () => {
      const firebaseUser = await authInit;
      if (!firebaseUser) {
        window.location.href = "/";
        return;
      }

      const urlParams = new URLSearchParams(window.location.search);
      const codeParam = urlParams.get("code");

      if (codeParam) {
        document.getElementById("invite_code")?.setAttribute("value", codeParam);
      }
    });

    document
      .getElementById("join-group-form")
      ?.addEventListener("submit", async (e) => {
        e.preventDefault();

        const input = document.getElementById("invite_code") as HTMLInputElement;
        const target = e.target as HTMLElement;
        const submitBtn = target.querySelector('button[type="submit"]');

        if (submitBtn) {
          (submitBtn as HTMLButtonElement).disabled = true;
          submitBtn.textContent = "Joining...";
        }

        try {
          await api.groups.join(input.value.toUpperCase());
          (window as any).showToast?.({ message: "Joined group successfully!", type: "success" });
          setTimeout(() => { window.location.href = "/dashboard"; }, 300);
        } catch (error: any) {
          (window as any).showToast?.({ message: error.message || "Failed to join group.", type: "error" });
          if (submitBtn) {
            (submitBtn as HTMLButtonElement).disabled = false;
            submitBtn.textContent = "Join Group";
          }
        }
      });
  </script>
</BaseLayout>
