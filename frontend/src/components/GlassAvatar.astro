---
interface Props {
  class?: string;
  src?: string | null;
  alt: string;
  size?: "sm" | "md" | "lg" | "xl";
  fallback?: string;
}

const { src, alt, size = "md", fallback } = Astro.props;

const sizeClasses = {
  sm: "w-8 h-8 text-xs",
  md: "w-10 h-10 text-sm",
  lg: "w-12 h-12 text-base",
  xl: "w-16 h-16 text-xl",
}[size];

const initial = (fallback || alt || "?").charAt(0).toUpperCase();
---

{
  src ? (
    <img
      src={src}
      alt={alt}
      class:list={["rounded-full object-cover", sizeClasses, Astro.props.class]}
      loading="lazy"
    />
  ) : (
    <div
      class:list={[
        "rounded-full flex items-center justify-center font-semibold",
        "bg-[var(--color-accent-soft)] text-[var(--color-accent)]",
        sizeClasses,
        Astro.props.class,
      ]}
      aria-label={alt}
    >
      {initial}
    </div>
  )
}
